@page "/property/{slug}"
@using ApartamentosRenta.Models
@using ApartamentosRenta.Services
@model ApartamentosRenta.Pages.Property.ViewModel
@{
    ViewData["Title"] = Model.Propiedad.Titulo;
    var fotos = Model.Propiedad.Fotos.ToList();
    var amenidades = Model.Propiedad.Amenidades
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var minVisitDate = DateTime.Today.ToString("yyyy-MM-dd");
    var maxBirth = DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd");
    var depositAmount = VisitDepositSettings.GetAmount(Model.Propiedad);
    var photoFallback = PropertyCatalogHelper.FallbackPhotoUrl;
}

<div class="listing-page">
    <header class="listing-header">
        <div class="listing-header-inner">
            <div class="listing-header-brand">
                <partial name="_BrandLockup" model="@BrandLockupOptions.For("listing")" />
            </div>
            <div class="listing-header-tools">
                <partial name="_LanguageToggle" />
                <a href="@Model.WhatsAppUrl" class="site-wa-chip" target="_blank" rel="noopener noreferrer" aria-label="@UiText.T("Property.ChatWa")">
                <span class="site-wa-chip-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.528 5.882L0 24l6.335-1.662A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.006-1.37l-.358-.214-3.742.982 1-3.648-.233-.375A9.818 9.818 0 1 1 12 21.818z"/>
                    </svg>
                </span>
                <span class="site-wa-chip-text">WhatsApp</span>
            </a>
            </div>
        </div>
    </header>

    <div class="listing-content">
    @if (fotos.Count > 0)
    {
        <div class="gallery-shell">
            <div class="gallery-viewer" id="galleryViewer">
                <span class="gallery-counter" id="galleryCounter">1 / @fotos.Count</span>
                @if (fotos.Count > 1)
                {
                    <button type="button" class="gallery-nav gallery-prev" id="galleryPrev" aria-label="@UiText.T("Property.PrevPhoto")">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
                    </button>
                    <button type="button" class="gallery-nav gallery-next" id="galleryNext" aria-label="@UiText.T("Property.NextPhoto")">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
                    </button>
                }
                <img id="mainPhoto" src="@fotos[0].Url" alt="@Model.Propiedad.Titulo" class="gallery-main"
                     onerror="this.onerror=null;this.src='@photoFallback';" />
            </div>

            @if (fotos.Count > 1)
            {
                <div class="gallery-strip">
                    @for (var i = 0; i < fotos.Count; i++)
                    {
                        <button type="button" class="gallery-thumb @(i == 0 ? "active" : "")" data-index="@i" data-photo="@fotos[i].Url" aria-label="@UiText.T("Property.PhotoN", i + 1)">
                            <img src="@fotos[i].Url" alt="" loading="lazy"
                                 onerror="this.onerror=null;this.src='@photoFallback';" />
                        </button>
                    }
                </div>
            }
        </div>
    }

        <div class="listing-card">
            <p class="property-location">@Model.Propiedad.Direccion · @Model.Propiedad.Ciudad</p>
            <h1 class="property-title">@Model.Propiedad.Titulo</h1>
            <p class="property-price">$@Model.Propiedad.PrecioMensual.ToString("N0")<span>@UiText.T("Property.PerMonth")</span></p>

            <div class="property-stats">
                <div><strong>@Model.Propiedad.Habitaciones</strong><span>@UiText.T("Property.Beds")</span></div>
                <div><strong>@Model.Propiedad.Banos</strong><span>@UiText.T("Property.Baths")</span></div>
                <div><strong>@Model.Propiedad.MetrosCuadrados</strong><span>m²</span></div>
            </div>

            <h2 class="section-title">@UiText.T("Property.About")</h2>
            <p class="property-description">@Model.Propiedad.Descripcion</p>

            @if (amenidades.Length > 0)
            {
                <h2 class="section-title">@UiText.T("Property.Amenities")</h2>
                <div class="property-tags">
                    @foreach (var item in amenidades)
                    {
                        <span class="property-tag">@item</span>
                    }
                </div>
            }

        </div>

        <div class="listing-card listing-form-card" id="schedule">
            <div class="form-card-header">
                <h2 class="form-card-title">@UiText.T("Property.ApplicationTitle")</h2>
                <p class="form-card-subtitle">@UiText.T("Property.ApplicationLead")</p>
                <div class="form-highlights">
                    <span>@UiText.T("Property.RefundableDeposit")</span>
                    <span>Visita de 30 minutos</span>
                    <span>Agente con licencia</span>
                </div>
            </div>

            <div id="formErrors" class="alert alert-danger d-none" role="alert"></div>

            <form method="post" class="cita-form" id="citaForm" novalidate>
                @Html.AntiForgeryToken()

                <fieldset class="form-section">
                    <legend class="form-section-title">@UiText.T("Form.PersonalInfo")</legend>
                    <div class="row g-3">
                        <div class="col-md-6 form-field">
                            <label asp-for="Appointment.NombreCliente" class="form-label">@UiText.T("Form.FirstName")</label>
                            <input asp-for="Appointment.NombreCliente" class="form-control" placeholder="Juan" autocomplete="given-name" />
                            <span asp-validation-for="Appointment.NombreCliente" class="field-error"></span>
                        </div>
                        <div class="col-md-6 form-field">
                            <label asp-for="Appointment.ApellidoCliente" class="form-label">@UiText.T("Form.LastName")</label>
                            <input asp-for="Appointment.ApellidoCliente" class="form-control" placeholder="Pérez" autocomplete="family-name" />
                            <span asp-validation-for="Appointment.ApellidoCliente" class="field-error"></span>
                        </div>
                        <div class="col-md-6 form-field">
                            <label asp-for="Appointment.Telefono" class="form-label">@UiText.T("Form.Phone")</label>
                            <input asp-for="Appointment.Telefono" id="phoneInput" class="form-control" type="tel"
                                   placeholder="(809) 690-9988" autocomplete="tel" maxlength="14" inputmode="numeric" />
                            <span asp-validation-for="Appointment.Telefono" class="field-error"></span>
                        </div>
                        <div class="col-md-6 form-field">
                            <label asp-for="Appointment.Email" class="form-label">@UiText.T("Form.Email")</label>
                            <input asp-for="Appointment.Email" class="form-control" type="email"
                                   placeholder="juan.perez@email.com" autocomplete="email" />
                            <span asp-validation-for="Appointment.Email" class="field-error"></span>
                        </div>
                        <div class="col-md-6 form-field">
                            <label asp-for="Appointment.FechaNacimiento" class="form-label">@UiText.T("Form.Dob")</label>
                            <input asp-for="Appointment.FechaNacimiento" class="form-control" type="date" max="@maxBirth" />
                            <span asp-validation-for="Appointment.FechaNacimiento" class="field-error"></span>
                        </div>
                        <div class="col-md-6 form-field">
                            <label asp-for="Appointment.SsnItin" class="form-label">@UiText.T("Form.Ssn")</label>
                            <input asp-for="Appointment.SsnItin" id="ssnInput" class="form-control"
                                   placeholder="XXX-XX-XXXX" autocomplete="off" inputmode="numeric" maxlength="11" />
                            <span class="form-hint">@UiText.T("Form.SsnHint")</span>
                            <span asp-validation-for="Appointment.SsnItin" class="field-error"></span>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="form-section">
                    <legend class="form-section-title">@UiText.T("Form.TourDetails")</legend>
                    <div class="row g-3">
                        <div class="col-md-6 form-field">
                            <label asp-for="Appointment.FechaCita" class="form-label">@UiText.T("Form.VisitDate")</label>
                            <input asp-for="Appointment.FechaCita" class="form-control" type="date" min="@minVisitDate" />
                            <span asp-validation-for="Appointment.FechaCita" class="field-error"></span>
                        </div>
                        <div class="col-md-6 form-field">
                            <label asp-for="Appointment.HoraCita" class="form-label">@UiText.T("Form.VisitTime")</label>
                            <input asp-for="Appointment.HoraCita" class="form-control" type="time" />
                            <span asp-validation-for="Appointment.HoraCita" class="field-error"></span>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="form-section">
                    <legend class="form-section-title">@UiText.T("Form.PropertyArea")</legend>
                    <div class="form-field">
                        <label asp-for="Appointment.CodigoPostal" class="form-label">@UiText.T("Form.Zip")</label>
                        <input asp-for="Appointment.CodigoPostal" class="form-control" placeholder="33101" maxlength="10" inputmode="numeric" />
                        <span asp-validation-for="Appointment.CodigoPostal" class="field-error"></span>
                    </div>
                </fieldset>

                <fieldset class="form-section">
                    <legend class="form-section-title">@UiText.T("Form.TenantInfo")</legend>
                    <div class="row g-3">
                        <div class="col-md-6 form-field">
                            <span class="form-label d-block">@UiText.T("Form.UsCitizen")</span>
                            <div class="yes-no-group">
                                <label class="yes-no-option"><input type="radio" name="Appointment.EsCiudadanoAmericano" value="true" required /> @UiText.T("Form.Yes")</label>
                                <label class="yes-no-option"><input type="radio" name="Appointment.EsCiudadanoAmericano" value="false" /> @UiText.T("Form.No")</label>
                            </div>
                            <span asp-validation-for="Appointment.EsCiudadanoAmericano" class="field-error"></span>
                        </div>
                        <div class="col-md-6 form-field">
                            <label asp-for="Appointment.PersonasEnUnidad" class="form-label">@UiText.T("Form.Occupants")</label>
                            <input asp-for="Appointment.PersonasEnUnidad" class="form-control" type="number" min="1" max="20" />
                            <span asp-validation-for="Appointment.PersonasEnUnidad" class="field-error"></span>
                        </div>
                        <div class="col-md-6 form-field">
                            <label asp-for="Appointment.DuracionContratoDeseada" class="form-label">@UiText.T("Form.LeaseLength")</label>
                            <input asp-for="Appointment.DuracionContratoDeseada" class="form-control" placeholder="@UiText.T("Form.LeasePlaceholder")" />
                            <span asp-validation-for="Appointment.DuracionContratoDeseada" class="field-error"></span>
                        </div>
                        <div class="col-md-6 form-field">
                            <label asp-for="Appointment.FechaMudanzaTemprana" class="form-label">@UiText.T("Form.MoveIn")</label>
                            <input asp-for="Appointment.FechaMudanzaTemprana" class="form-control" type="date" min="@minVisitDate" />
                            <span asp-validation-for="Appointment.FechaMudanzaTemprana" class="field-error"></span>
                        </div>
                        <div class="col-12 form-field">
                            <span class="form-label d-block">@UiText.T("Form.Smokes")</span>
                            <div class="yes-no-group">
                                <label class="yes-no-option"><input type="radio" name="Appointment.Fuma" value="true" required /> @UiText.T("Form.Yes")</label>
                                <label class="yes-no-option"><input type="radio" name="Appointment.Fuma" value="false" /> @UiText.T("Form.No")</label>
                            </div>
                            <span asp-validation-for="Appointment.Fuma" class="field-error"></span>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="form-section">
                    <legend class="form-section-title">@UiText.T("Form.Employment")</legend>
                    <div class="row g-3">
                        <div class="col-12 form-field">
                            <span class="form-label d-block">@UiText.T("Form.Employed")</span>
                            <div class="yes-no-group">
                                <label class="yes-no-option"><input type="radio" name="Appointment.EmpleadoActualmente" value="true" required /> @UiText.T("Form.Yes")</label>
                                <label class="yes-no-option"><input type="radio" name="Appointment.EmpleadoActualmente" value="false" /> @UiText.T("Form.No")</label>
                            </div>
                            <span asp-validation-for="Appointment.EmpleadoActualmente" class="field-error"></span>
                        </div>
                        <div class="col-md-6 form-field d-none" id="employmentFields">
                            <label asp-for="Appointment.NombreCompania" class="form-label">@UiText.T("Form.Employer")</label>
                            <input asp-for="Appointment.NombreCompania" class="form-control" placeholder="@UiText.T("Form.CompanyPlaceholder")" />
                            <span asp-validation-for="Appointment.NombreCompania" class="field-error"></span>
                        </div>
                        <div class="col-md-6 form-field d-none" id="salaryField">
                            <label asp-for="Appointment.Salario" class="form-label">@UiText.T("Form.Income")</label>
                            <input asp-for="Appointment.Salario" class="form-control" type="number" min="0" step="0.01" placeholder="2500" />
                            <span asp-validation-for="Appointment.Salario" class="field-error"></span>
                        </div>
                        <div class="col-12 form-field">
                            <label asp-for="Appointment.DisponibleParaAsegurar" class="form-label">@UiText.T("Form.AvailableFunds")</label>
                            <input asp-for="Appointment.DisponibleParaAsegurar" class="form-control" type="number" min="0" step="0.01" placeholder="5000" />
                            <span asp-validation-for="Appointment.DisponibleParaAsegurar" class="field-error"></span>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="form-section">
                    <legend class="form-section-title">@UiText.T("Form.Additional")</legend>
                    <div class="row g-3">
                        <div class="col-md-6 form-field">
                            <span class="form-label d-block">@UiText.T("Form.Pets")</span>
                            <div class="yes-no-group">
                                <label class="yes-no-option"><input type="radio" name="Appointment.TieneMascotas" value="true" required /> @UiText.T("Form.Yes")</label>
                                <label class="yes-no-option"><input type="radio" name="Appointment.TieneMascotas" value="false" /> @UiText.T("Form.No")</label>
                            </div>
                            <span asp-validation-for="Appointment.TieneMascotas" class="field-error"></span>
                        </div>
                        <div class="col-md-6 form-field">
                            <span class="form-label d-block">@UiText.T("Form.AcceptDeposit")</span>
                            <div class="yes-no-group">
                                <label class="yes-no-option"><input type="radio" name="Appointment.AceptaDepositoReserva" value="true" required /> @UiText.T("Form.Yes")</label>
                                <label class="yes-no-option"><input type="radio" name="Appointment.AceptaDepositoReserva" value="false" /> @UiText.T("Form.No")</label>
                            </div>
                            <span asp-validation-for="Appointment.AceptaDepositoReserva" class="field-error"></span>
                        </div>
                    </div>
                </fieldset>

                <div class="form-program-box">
                    <h3 class="h6 mb-2">@UiText.T("Form.CertifiedProgram")</h3>
                    <p class="small mb-2">
                        @Html.Raw(UiText.T("Form.CertifiedProgramBody", depositAmount.ToString("N0")))
                    </p>
                    <p class="payment-refundable-note mb-2"><strong>@UiText.T("Form.RefundableNote")</strong></p>
                    <ul class="small mb-2">
                        <li>@UiText.T("Form.RefundBullet1")</li>
                        <li>@UiText.T("Form.RefundBullet2", depositAmount.ToString("N0"))</li>
                        <li>@UiText.T("Form.RefundBullet3")</li>
                    </ul>
                </div>

                <fieldset class="form-section">
                    <legend class="form-section-title">@UiText.T("Form.PaymentOptions")</legend>
                    <div class="row g-3">
                        <div class="col-12 form-field">
                            <span class="form-label d-block">@UiText.T("Form.PayTourFeeAmount", depositAmount.ToString("N0"))</span>
                            <div class="yes-no-group">
                                <label class="yes-no-option"><input type="radio" name="Appointment.PagaraCitaCertificada" value="true" required /> @UiText.T("Form.Yes")</label>
                                <label class="yes-no-option"><input type="radio" name="Appointment.PagaraCitaCertificada" value="false" /> @UiText.T("Form.No")</label>
                            </div>
                            <span asp-validation-for="Appointment.PagaraCitaCertificada" class="field-error"></span>
                        </div>
                        <div class="col-12 form-field d-none" id="paymentMethodField">
                            <span class="form-label d-block">@UiText.T("Form.PaymentMethod")</span>
                            <div class="payment-zelle-only">
                                <span class="payment-zelle-badge">Zelle</span>
                                <p class="payment-refundable-note mb-2 mt-2"><strong>@UiText.T("Form.RefundableNote")</strong></p>
                                <p class="small text-muted mb-0">@UiText.T("Form.ZelleAfterApproval")</p>
                            </div>
                        </div>
                    </div>
                </fieldset>

                <label class="terms-check mb-3">
                    <input asp-for="Appointment.AceptaTerminos" />
                    <span>@UiText.T("Form.Terms")</span>
                </label>
                <span asp-validation-for="Appointment.AceptaTerminos" class="field-error d-block mb-2"></span>

                <button type="submit" class="btn btn-submit w-100" id="submitBtn">
                    @UiText.T("Form.Submit")
                </button>
            </form>
        </div>
    </div>
</div>

<div class="wa-float-widget" aria-label="Chat de WhatsApp">
    <span class="wa-float-cloud">WhatsApp</span>
    <a href="@Model.WhatsAppUrl" class="wa-float-bubble" target="_blank" rel="noopener noreferrer" aria-label="Abrir chat de WhatsApp">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.528 5.882L0 24l6.335-1.662A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.006-1.37l-.358-.214-3.742.982 1-3.648-.233-.375A9.818 9.818 0 1 1 12 21.818z"/>
        </svg>
    </a>
</div>

<div class="status-modal" id="statusModal" aria-hidden="true">
    <div class="status-modal-backdrop"></div>
    <div class="status-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div id="modalTerms" class="modal-terms-panel d-none">
            <h3 class="modal-title">Términos y condiciones</h3>
            <div class="terms-summary">
                <p>Al continuar, autorizas a Premier Property Hub a verificar la información que proporcionaste para tu solicitud de alquiler.</p>
                <ul>
                    <li>Esta revisión utiliza una <strong>consulta de crédito suave</strong>.</li>
                    <li><strong>No afectará negativamente tu puntaje de crédito.</strong></li>
                    <li>Tus datos se usan solo para procesar esta solicitud y agendar tu visita.</li>
                </ul>
            </div>
            <label class="terms-check">
                <input type="checkbox" id="termsCheckbox" />
                <span>He leído y acepto los Términos y Condiciones.</span>
            </label>
            <button type="button" class="btn btn-submit w-100 mt-3" id="termsAcceptBtn" disabled>
                Acepto y continuar
            </button>
        </div>
        <div id="modalLoading" class="d-none">
            <h3 id="modalTitle" class="modal-title">Procesando tu solicitud</h3>
            <p class="modal-text">Espera mientras revisamos tu información…</p>
            <div class="progress-track" aria-hidden="true">
                <div class="progress-fill" id="progressBar"></div>
            </div>
            <p class="progress-label" id="progressLabel">0%</p>
        </div>
        <div id="modalSuccess" class="d-none modal-success-panel">
            <div class="success-confetti" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="modal-success-icon" aria-hidden="true">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </div>
            <p class="success-badge">Aprobado</p>
            <h3 class="modal-title success-title">¡Felicidades!</h3>
            <p class="modal-text success-lead">Has sido aprobado.</p>
            <p class="modal-text success-contact">
                Un último paso: completa tu depósito de visita vía <strong>Zelle</strong> para asegurar tu cita.
            </p>
            <p class="payment-refundable-note mt-2"><strong>Este pago es reembolsable al momento de irse de la propiedad.</strong></p>
        </div>
        <div id="modalDepositLoading" class="d-none">
            <h3 class="modal-title">Casi listo</h3>
            <p class="modal-text">El paso final es enviar tu depósito de visita vía Zelle.</p>
            <div class="progress-track" aria-hidden="true">
                <div class="progress-fill" id="depositProgressBar"></div>
            </div>
            <p class="progress-label" id="depositProgressLabel">0%</p>
        </div>
        <div id="modalDeposit" class="d-none modal-deposit-panel">
            <h3 class="modal-title text-start">Completa tu depósito con Zelle</h3>
            <p class="modal-text text-start">Envía el depósito indicado abajo y luego sube la captura del pago.</p>
            <p class="payment-refundable-note text-start mb-3"><strong>Este pago es reembolsable al momento de irse de la propiedad.</strong></p>
            <div class="zelle-card">
                <div class="zelle-row"><span>Monto</span><strong id="zelleAmount">$0</strong></div>
                <div class="zelle-row"><span>Enviar a</span><strong id="zelleName">—</strong></div>
                <div class="zelle-row zelle-row-contact"><span>Zelle</span><strong id="zelleContact" class="font-monospace">—</strong></div>
            </div>
            <p id="zelleWhatsAppHint" class="zelle-whatsapp-hint d-none">
                Zelle no está configurado para este listado.
                <a id="zelleWhatsAppLink" href="@Model.WhatsAppUrl" target="_blank" rel="noopener noreferrer">Haz clic aquí para contactar a tu agente por WhatsApp</a>
                — la forma más rápida de obtener los datos de pago.
            </p>
            <div class="payment-upload-box">
                <label for="paymentProofInput" class="form-label">@UiText.T("Property.PaymentProof")</label>
                <input type="file" id="paymentProofInput" class="form-control" accept="image/*" />
                <div id="paymentPreviewWrap" class="payment-preview-wrap d-none">
                    <img id="paymentPreview" alt="Vista previa del pago" />
                </div>
                <div id="uploadProgressWrap" class="d-none mt-3">
                    <div class="progress-track mb-1">
                        <div class="progress-fill" id="uploadProgressBar"></div>
                    </div>
                    <p class="progress-label mb-0" id="uploadProgressLabel">Subiendo… 0%</p>
                </div>
            </div>
            <p id="depositError" class="text-danger small d-none mt-2"></p>
            <button type="button" class="btn btn-submit w-100 mt-3" id="submitPaymentBtn" disabled>
                Enviar comprobante de pago
            </button>
        </div>
        <div id="modalWaiting" class="d-none text-center">
            <div class="modal-waiting-icon" aria-hidden="true">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
            </div>
            <h3 class="modal-title">Esperando confirmación</h3>
            <p class="modal-text">Recibimos tu comprobante de pago. Un agente lo está revisando. Mantén esta página abierta.</p>
            <div class="waiting-pulse" aria-hidden="true"></div>
        </div>
        <div id="modalConfirmed" class="d-none modal-success-panel">
            <div class="modal-success-icon" aria-hidden="true">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </div>
            <p class="success-badge">Confirmado</p>
            <h3 class="modal-title success-title">¡Tu visita está confirmada!</h3>
            <p class="modal-text success-contact mb-0">
                Tu depósito fue aprobado. Te contactaremos por <strong>teléfono</strong> o <strong>WhatsApp</strong> con los detalles finales.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.gallery-thumb').forEach(btn => {
            btn.addEventListener('click', () => goToPhoto(parseInt(btn.dataset.index, 10)));
        });

        const photos = [@Html.Raw(string.Join(",", fotos.Select(f => $"\"{f.Url}\"")))];
        let currentIndex = 0;
        const mainPhoto = document.getElementById('mainPhoto');
        const counter = document.getElementById('galleryCounter');
        const prevBtn = document.getElementById('galleryPrev');
        const nextBtn = document.getElementById('galleryNext');
        const viewer = document.getElementById('galleryViewer');

        function goToPhoto(index) {
            if (!photos.length) return;
            currentIndex = (index + photos.length) % photos.length;
            mainPhoto.style.opacity = '0';
            setTimeout(() => {
                mainPhoto.src = photos[currentIndex];
                mainPhoto.style.opacity = '1';
            }, 150);
            if (counter) counter.textContent = `${currentIndex + 1} / ${photos.length}`;
            document.querySelectorAll('.gallery-thumb').forEach((b, i) => {
                b.classList.toggle('active', i === currentIndex);
                if (i === currentIndex) b.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
            });
        }

        prevBtn?.addEventListener('click', () => goToPhoto(currentIndex - 1));
        nextBtn?.addEventListener('click', () => goToPhoto(currentIndex + 1));

        function formatPhone(value) {
            const digits = value.replace(/\D/g, '').slice(0, 10);
            if (digits.length === 0) return '';
            if (digits.length < 4) return `(${digits}`;
            if (digits.length < 7) return `(${digits.slice(0, 3)}) ${digits.slice(3)}`;
            return `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
        }

        function formatSsn(value) {
            const digits = value.replace(/\D/g, '').slice(0, 9);
            if (digits.length <= 3) return digits;
            if (digits.length <= 5) return `${digits.slice(0, 3)}-${digits.slice(3)}`;
            return `${digits.slice(0, 3)}-${digits.slice(3, 5)}-${digits.slice(5)}`;
        }

        function bindMask(input, formatter) {
            if (!input) return;
            input.addEventListener('input', () => {
                const start = input.selectionStart;
                const before = input.value;
                input.value = formatter(input.value);
                const diff = input.value.length - before.length;
                input.setSelectionRange(start + diff, start + diff);
            });
            input.addEventListener('paste', (e) => {
                e.preventDefault();
                const text = (e.clipboardData || window.clipboardData).getData('text');
                input.value = formatter(text);
            });
        }

        bindMask(document.getElementById('phoneInput'), formatPhone);
        bindMask(document.getElementById('ssnInput'), formatSsn);

        const employmentFields = document.getElementById('employmentFields');
        const salaryField = document.getElementById('salaryField');
        const paymentMethodField = document.getElementById('paymentMethodField');

        function isEmployedSelected() {
            return document.querySelector('input[name="Appointment.EmpleadoActualmente"]:checked')?.value === 'true';
        }

        function willPayVisitSelected() {
            return document.querySelector('input[name="Appointment.PagaraCitaCertificada"]:checked')?.value === 'true';
        }

        function updateEmploymentFields() {
            const show = isEmployedSelected();
            employmentFields?.classList.toggle('d-none', !show);
            salaryField?.classList.toggle('d-none', !show);
        }

        function updatePaymentMethodField() {
            paymentMethodField?.classList.toggle('d-none', !willPayVisitSelected());
        }

        document.querySelectorAll('input[name="Appointment.EmpleadoActualmente"]').forEach(radio => {
            radio.addEventListener('change', updateEmploymentFields);
        });
        document.querySelectorAll('input[name="Appointment.PagaraCitaCertificada"]').forEach(radio => {
            radio.addEventListener('change', updatePaymentMethodField);
        });
        updateEmploymentFields();
        updatePaymentMethodField();

        let touchStartX = 0;
        viewer?.addEventListener('touchstart', e => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
        viewer?.addEventListener('touchend', e => {
            const diff = e.changedTouches[0].screenX - touchStartX;
            if (Math.abs(diff) > 50) goToPhoto(currentIndex + (diff < 0 ? 1 : -1));
        }, { passive: true });

        const form = document.getElementById('citaForm');
        const modal = document.getElementById('statusModal');
        const modalTerms = document.getElementById('modalTerms');
        const modalLoading = document.getElementById('modalLoading');
        const modalSuccess = document.getElementById('modalSuccess');
        const modalDepositLoading = document.getElementById('modalDepositLoading');
        const modalDeposit = document.getElementById('modalDeposit');
        const modalWaiting = document.getElementById('modalWaiting');
        const modalConfirmed = document.getElementById('modalConfirmed');
        const depositProgressBar = document.getElementById('depositProgressBar');
        const depositProgressLabel = document.getElementById('depositProgressLabel');
        const zelleAmount = document.getElementById('zelleAmount');
        const zelleName = document.getElementById('zelleName');
        const zelleContact = document.getElementById('zelleContact');
        const zelleWhatsAppHint = document.getElementById('zelleWhatsAppHint');
        const zelleWhatsAppLink = document.getElementById('zelleWhatsAppLink');
        const pageWhatsAppUrl = '@Model.WhatsAppUrl';
        const paymentProofInput = document.getElementById('paymentProofInput');
        const paymentPreviewWrap = document.getElementById('paymentPreviewWrap');
        const paymentPreview = document.getElementById('paymentPreview');
        const uploadProgressWrap = document.getElementById('uploadProgressWrap');
        const uploadProgressBar = document.getElementById('uploadProgressBar');
        const uploadProgressLabel = document.getElementById('uploadProgressLabel');
        const depositError = document.getElementById('depositError');
        const submitPaymentBtn = document.getElementById('submitPaymentBtn');
        const termsCheckbox = document.getElementById('termsCheckbox');
        const termsAcceptBtn = document.getElementById('termsAcceptBtn');
        const progressBar = document.getElementById('progressBar');
        const progressLabel = document.getElementById('progressLabel');
        const formErrors = document.getElementById('formErrors');
        const submitBtn = document.getElementById('submitBtn');
        const phoneInput = document.getElementById('phoneInput');
        const ssnInput = document.getElementById('ssnInput');

        const phonePattern = /^\(\d{3}\) \d{3}-\d{4}$/;
        const ssnPattern = /^\d{3}-\d{2}-\d{4}$/;

        let appointmentToken = null;
        let zelleInfo = null;
        let statusPollTimer = null;
        let selectedPaymentFile = null;

        function getAntiforgeryToken() {
            return form.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function formatCurrency(amount) {
            const value = Number(amount) || 0;
            return '$' + value.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
        }

        const fieldLabels = {
            'Appointment.NombreCliente': 'Nombre',
            'Appointment.ApellidoCliente': 'Apellido',
            'Appointment.Telefono': 'Teléfono / WhatsApp',
            'Appointment.Email': 'Correo electrónico',
            'Appointment.FechaNacimiento': 'Fecha de nacimiento',
            'Appointment.FechaCita': 'Fecha de visita',
            'Appointment.HoraCita': 'Hora de visita',
            'Appointment.CodigoPostal': 'Código postal',
            'Appointment.EsCiudadanoAmericano': 'Ciudadanía estadounidense',
            'Appointment.PersonasEnUnidad': 'Personas en la unidad',
            'Appointment.DuracionContratoDeseada': 'Duración del contrato',
            'Appointment.FechaMudanzaTemprana': 'Fecha de mudanza',
            'Appointment.Fuma': '¿Fuma?',
            'Appointment.EmpleadoActualmente': '¿Empleado actualmente?',
            'Appointment.NombreCompania': 'Nombre del empleador / empresa',
            'Appointment.Salario': 'Salario',
            'Appointment.DisponibleParaAsegurar': 'Disponible para asegurar',
            'Appointment.TieneMascotas': '¿Tiene mascotas?',
            'Appointment.AceptaDepositoReserva': 'Acepta depósito de reserva',
            'Appointment.PagaraCitaCertificada': 'Pago de visita certificada',
            'Appointment.AceptaTerminos': 'Términos y políticas'
        };

        function clearFieldValidation() {
            form.querySelectorAll('.form-field.is-invalid').forEach(el => el.classList.remove('is-invalid'));
            form.querySelectorAll('.field-inline-error').forEach(el => el.remove());
        }

        function markFieldInvalid(name, message) {
            const field = form.querySelector(`[name="${name}"]`);
            if (!field) return;
            const wrapper = field.closest('.form-field') || field.closest('.terms-check')?.parentElement;
            if (wrapper?.classList.contains('form-field')) {
                wrapper.classList.add('is-invalid');
                if (message && !wrapper.querySelector('.field-inline-error')) {
                    const span = document.createElement('span');
                    span.className = 'field-inline-error';
                    span.textContent = message;
                    wrapper.appendChild(span);
                }
            }
        }

        function isRadioGroupChecked(name) {
            return form.querySelector(`input[name="${name}"]:checked`) !== null;
        }

        function isEmptyValue(el) {
            if (!el) return true;
            if (el.type === 'checkbox') return !el.checked;
            const val = (el.value || '').trim();
            return val === '';
        }

        function validateForm() {
            clearFieldValidation();
            formErrors.classList.add('d-none');
            formErrors.innerHTML = '';

            const errors = [];
            const missing = [];

            form.querySelectorAll('[required]').forEach(el => {
                const name = el.name;
                if (!name) return;
                if (el.type === 'radio') {
                    if (!isRadioGroupChecked(name)) {
                        missing.push(fieldLabels[name] || name);
                        markFieldInvalid(name, 'Selecciona una opción.');
                    }
                } else if (isEmptyValue(el)) {
                    missing.push(fieldLabels[name] || name);
                    markFieldInvalid(name, 'Este campo es obligatorio.');
                }
            });

            if (!isRadioGroupChecked('Appointment.EsCiudadanoAmericano')) {
                if (!missing.includes(fieldLabels['Appointment.EsCiudadanoAmericano'])) {
                    missing.push(fieldLabels['Appointment.EsCiudadanoAmericano']);
                    markFieldInvalid('Appointment.EsCiudadanoAmericano', 'Selecciona una opción.');
                }
            }
            if (!isRadioGroupChecked('Appointment.Fuma')) {
                if (!missing.includes(fieldLabels['Appointment.Fuma'])) {
                    missing.push(fieldLabels['Appointment.Fuma']);
                    markFieldInvalid('Appointment.Fuma', 'Selecciona una opción.');
                }
            }
            if (!isRadioGroupChecked('Appointment.EmpleadoActualmente')) {
                if (!missing.includes(fieldLabels['Appointment.EmpleadoActualmente'])) {
                    missing.push(fieldLabels['Appointment.EmpleadoActualmente']);
                    markFieldInvalid('Appointment.EmpleadoActualmente', 'Selecciona una opción.');
                }
            }
            if (!isRadioGroupChecked('Appointment.TieneMascotas')) {
                if (!missing.includes(fieldLabels['Appointment.TieneMascotas'])) {
                    missing.push(fieldLabels['Appointment.TieneMascotas']);
                    markFieldInvalid('Appointment.TieneMascotas', 'Selecciona una opción.');
                }
            }
            if (!isRadioGroupChecked('Appointment.AceptaDepositoReserva')) {
                if (!missing.includes(fieldLabels['Appointment.AceptaDepositoReserva'])) {
                    missing.push(fieldLabels['Appointment.AceptaDepositoReserva']);
                    markFieldInvalid('Appointment.AceptaDepositoReserva', 'Selecciona una opción.');
                }
            }
            if (!isRadioGroupChecked('Appointment.PagaraCitaCertificada')) {
                if (!missing.includes(fieldLabels['Appointment.PagaraCitaCertificada'])) {
                    missing.push(fieldLabels['Appointment.PagaraCitaCertificada']);
                    markFieldInvalid('Appointment.PagaraCitaCertificada', 'Selecciona una opción.');
                }
            }

            if (isEmployedSelected()) {
                const company = form.querySelector('[name="Appointment.NombreCompania"]');
                const salary = form.querySelector('[name="Appointment.Salario"]');
                if (isEmptyValue(company)) {
                    missing.push(fieldLabels['Appointment.NombreCompania']);
                    markFieldInvalid('Appointment.NombreCompania', 'Este campo es obligatorio.');
                }
                if (isEmptyValue(salary)) {
                    missing.push(fieldLabels['Appointment.Salario']);
                    markFieldInvalid('Appointment.Salario', 'Este campo es obligatorio.');
                }
            }

            if (!phonePattern.test(phoneInput.value.trim())) {
                errors.push('Ingresa un teléfono válido: (809) 690-9988');
                markFieldInvalid('Appointment.Telefono', 'Teléfono inválido.');
            }

            const ssnValue = ssnInput.value.trim();
            if (ssnValue && !ssnPattern.test(ssnValue)) {
                errors.push('Ingresa un SSN válido: 121-22-1123');
                markFieldInvalid('Appointment.SsnItin', 'SSN inválido.');
            }

            const visitDate = form.querySelector('[name="Appointment.FechaCita"]')?.value;
            const visitTime = form.querySelector('[name="Appointment.HoraCita"]')?.value;
            if (visitDate && visitTime) {
                const visitAt = new Date(`${visitDate}T${visitTime}`);
                if (Number.isNaN(visitAt.getTime()) || visitAt <= new Date()) {
                    errors.push('Elige una fecha y hora de visita en el futuro.');
                    markFieldInvalid('Appointment.FechaCita', 'Fecha inválida.');
                    markFieldInvalid('Appointment.HoraCita', 'Hora inválida.');
                }
            }

            const termsCheck = form.querySelector('[name="Appointment.AceptaTerminos"]');
            if (!termsCheck?.checked) {
                errors.push('Debes aceptar los términos y políticas.');
                markFieldInvalid('Appointment.AceptaTerminos', 'Debes aceptar los términos.');
            }

            if (missing.length) {
                const unique = [...new Set(missing)];
                errors.unshift(`Completa los campos obligatorios: ${unique.join(', ')}.`);
            }

            if (errors.length) {
                formErrors.innerHTML = errors.map(m => `<div>${m}</div>`).join('');
                formErrors.classList.remove('d-none');
                document.getElementById('schedule')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                return false;
            }

            return true;
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            if (!validateForm()) return;

            submitBtn.disabled = true;
            termsCheckbox.checked = false;
            termsAcceptBtn.disabled = true;
            showModal('terms');
        });

        termsCheckbox?.addEventListener('change', () => {
            termsAcceptBtn.disabled = !termsCheckbox.checked;
        });

        termsAcceptBtn?.addEventListener('click', () => processApplication());

        async function processApplication() {
            if (!termsCheckbox.checked) return;

            resetProgress();
            showModal('loading');
            startProgress(6000);

            const formData = new FormData(form);
            const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const submitPromise = fetch(window.location.pathname, {
                method: 'POST',
                body: formData,
                credentials: 'same-origin',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': token || ''
                }
            });

            await new Promise(resolve => setTimeout(resolve, 6000));

            try {
                const response = await submitPromise;
                const contentType = response.headers.get('content-type') || '';

                if (!response.ok) {
                    hideModal();
                    submitBtn.disabled = false;

                    if (contentType.includes('application/json')) {
                        const data = await response.json();
                        if (data.errors) {
                            const messages = Object.values(data.errors);
                            formErrors.innerHTML = messages.map(m => `<div>${m}</div>`).join('');
                            formErrors.classList.remove('d-none');
                            return;
                        }
                    }

                    formErrors.textContent = response.status === 400
                        ? 'La sesión expiró. Recarga la página e intenta de nuevo.'
                        : 'Algo salió mal. Intenta de nuevo.';
                    formErrors.classList.remove('d-none');
                    return;
                }

                let data = {};
                if (contentType.includes('application/json')) {
                    data = await response.json();
                }

                appointmentToken = data.token;
                zelleInfo = data.zelle;
                if (data.antiforgeryToken) {
                    const antiforgeryInput = form.querySelector('input[name="__RequestVerificationToken"]');
                    if (antiforgeryInput) antiforgeryInput.value = data.antiforgeryToken;
                }
                form.reset();
                if (data.antiforgeryToken) {
                    const antiforgeryInput = form.querySelector('input[name="__RequestVerificationToken"]');
                    if (antiforgeryInput) antiforgeryInput.value = data.antiforgeryToken;
                }
                submitBtn.disabled = false;

                showModal('success');
                setTimeout(() => startDepositFlow(), 2500);
            } catch {
                hideModal();
                submitBtn.disabled = false;
                formErrors.textContent = 'Algo salió mal. Intenta de nuevo.';
                formErrors.classList.remove('d-none');
            }
        }

        function startDepositFlow() {
            resetDepositProgress();
            showModal('depositLoading');
            startProgressOn(depositProgressBar, depositProgressLabel, 5000, () => {
                populateZellePanel();
                showModal('deposit');
            });
        }

        function populateZellePanel() {
            const info = zelleInfo || {};
            zelleAmount.textContent = formatCurrency(info.depositAmount);
            zelleName.textContent = info.displayName || 'Premier Property Hub';

            const contact = (info.contact || '').trim();
            const whatsAppUrl = info.whatsAppUrl || pageWhatsAppUrl;

            zelleContact.innerHTML = '';
            zelleContact.className = '';

            if (contact) {
                zelleContact.className = 'font-monospace';
                zelleContact.textContent = contact;
                zelleWhatsAppHint?.classList.add('d-none');
            } else if (whatsAppUrl) {
                const link = document.createElement('a');
                link.href = whatsAppUrl;
                link.target = '_blank';
                link.rel = 'noopener noreferrer';
                link.className = 'zelle-contact-link';
                link.textContent = 'Contacta a tu agente';
                zelleContact.appendChild(link);
                if (zelleWhatsAppLink) {
                    zelleWhatsAppLink.href = whatsAppUrl;
                }
                zelleWhatsAppHint?.classList.remove('d-none');
            } else {
                zelleContact.textContent = '—';
                zelleWhatsAppHint?.classList.add('d-none');
            }

            paymentProofInput.value = '';
            paymentPreviewWrap.classList.add('d-none');
            uploadProgressWrap.classList.add('d-none');
            depositError.classList.add('d-none');
            depositError.textContent = '';
            submitPaymentBtn.disabled = true;
            selectedPaymentFile = null;
        }

        paymentProofInput?.addEventListener('change', () => {
            depositError.classList.add('d-none');
            const file = paymentProofInput.files?.[0];
            selectedPaymentFile = file || null;

            if (!file) {
                paymentPreviewWrap.classList.add('d-none');
                submitPaymentBtn.disabled = true;
                return;
            }

            if (!file.type.startsWith('image/')) {
                depositError.textContent = 'Selecciona un archivo de imagen.';
                depositError.classList.remove('d-none');
                submitPaymentBtn.disabled = true;
                return;
            }

            paymentPreview.src = URL.createObjectURL(file);
            paymentPreviewWrap.classList.remove('d-none');
            submitPaymentBtn.disabled = false;
        });

        submitPaymentBtn?.addEventListener('click', () => submitPaymentProof());

        async function submitPaymentProof() {
            if (!appointmentToken || !selectedPaymentFile) return;

            depositError.classList.add('d-none');
            submitPaymentBtn.disabled = true;
            uploadProgressWrap.classList.remove('d-none');
            resetUploadProgress();

            const uploadUrl = `${window.location.pathname}?handler=UploadPayment&token=${appointmentToken}`;
            const formData = new FormData();
            formData.append('paymentProof', selectedPaymentFile);
            const antiforgeryToken = getAntiforgeryToken();
            if (antiforgeryToken) {
                formData.append('__RequestVerificationToken', antiforgeryToken);
            }

            const uploadPromise = fetch(uploadUrl, {
                method: 'POST',
                body: formData,
                credentials: 'same-origin',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': antiforgeryToken
                }
            });

            await animateUploadProgress(2200);

            try {
                const response = await uploadPromise;
                const data = await response.json().catch(() => ({}));

                if (!response.ok) {
                    depositError.textContent = data.message || 'No se pudo subir el comprobante. Intenta de nuevo.';
                    depositError.classList.remove('d-none');
                    submitPaymentBtn.disabled = true;
                    uploadProgressWrap.classList.add('d-none');
                    return;
                }

                showModal('waiting');
                startStatusPolling();
            } catch {
                depositError.textContent = 'Algo salió mal. Intenta de nuevo.';
                depositError.classList.remove('d-none');
                submitPaymentBtn.disabled = false;
                uploadProgressWrap.classList.add('d-none');
            }
        }

        function resetUploadProgress() {
            uploadProgressBar.style.width = '0%';
            uploadProgressLabel.textContent = 'Subiendo… 0%';
        }

        function animateUploadProgress(durationMs) {
            return new Promise(resolve => {
                const start = performance.now();

                function tick(now) {
                    const elapsed = now - start;
                    const pct = Math.min(100, Math.round((elapsed / durationMs) * 100));
                    uploadProgressBar.style.width = pct + '%';
                    uploadProgressLabel.textContent = `Subiendo… ${pct}%`;
                    if (elapsed < durationMs) {
                        requestAnimationFrame(tick);
                    } else {
                        resolve();
                    }
                }

                requestAnimationFrame(tick);
            });
        }

        function startStatusPolling() {
            stopStatusPolling();
            checkAppointmentStatus();
            statusPollTimer = setInterval(checkAppointmentStatus, 4000);
        }

        function stopStatusPolling() {
            if (statusPollTimer) {
                clearInterval(statusPollTimer);
                statusPollTimer = null;
            }
        }

        async function checkAppointmentStatus() {
            if (!appointmentToken) return;

            const statusUrl = `${window.location.pathname}?handler=Status&token=${appointmentToken}`;

            try {
                const response = await fetch(statusUrl, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) return;

                const data = await response.json();
                if (data.confirmed) {
                    stopStatusPolling();
                    showModal('confirmed');
                } else if (data.status === 'EsperandoConfirmacion') {
                    showModal('waiting');
                }
            } catch {
                /* keep polling */
            }
        }

        function resetDepositProgress() {
            depositProgressBar.style.width = '0%';
            depositProgressLabel.textContent = '0%';
        }

        function resetProgress() {
            progressBar.style.width = '0%';
            progressLabel.textContent = '0%';
        }

        function startProgress(durationMs) {
            startProgressOn(progressBar, progressLabel, durationMs);
        }

        function startProgressOn(barEl, labelEl, durationMs, onComplete) {
            const start = performance.now();

            function tick(now) {
                const elapsed = now - start;
                const pct = Math.min(100, Math.round((elapsed / durationMs) * 100));
                barEl.style.width = pct + '%';
                labelEl.textContent = pct + '%';
                if (elapsed < durationMs) {
                    requestAnimationFrame(tick);
                } else if (onComplete) {
                    onComplete();
                }
            }

            requestAnimationFrame(tick);
        }

        function showModal(state) {
            modal.classList.add('is-visible');
            modal.setAttribute('aria-hidden', 'false');
            const dialog = modal.querySelector('.status-modal-dialog');
            dialog?.classList.remove('is-success', 'is-terms', 'is-deposit', 'is-wide');

            modalTerms.classList.toggle('d-none', state !== 'terms');
            modalLoading.classList.toggle('d-none', state !== 'loading');
            modalSuccess.classList.toggle('d-none', state !== 'success');
            modalDepositLoading.classList.toggle('d-none', state !== 'depositLoading');
            modalDeposit.classList.toggle('d-none', state !== 'deposit');
            modalWaiting.classList.toggle('d-none', state !== 'waiting');
            modalConfirmed.classList.toggle('d-none', state !== 'confirmed');

            if (state === 'terms') dialog?.classList.add('is-terms');
            if (state === 'success' || state === 'confirmed') dialog?.classList.add('is-success');
            if (state === 'deposit' || state === 'depositLoading') dialog?.classList.add('is-deposit', 'is-wide');
            if (state === 'waiting') dialog?.classList.add('is-wide');
        }

        function hideModal() {
            stopStatusPolling();
            modal.classList.remove('is-visible');
            modal.setAttribute('aria-hidden', 'true');
            modalTerms.classList.add('d-none');
            modalLoading.classList.add('d-none');
            modalSuccess.classList.add('d-none');
            modalDepositLoading.classList.add('d-none');
            modalDeposit.classList.add('d-none');
            modalWaiting.classList.add('d-none');
            modalConfirmed.classList.add('d-none');
            modal.querySelector('.status-modal-dialog')?.classList.remove('is-success', 'is-terms', 'is-deposit', 'is-wide');
            termsCheckbox.checked = false;
            termsAcceptBtn.disabled = true;
            resetProgress();
            resetDepositProgress();
        }
    </script>
}
