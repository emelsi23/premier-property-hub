@page "/property/{slug}/thank-you"
@model ApartamentosRenta.Pages.Property.ThankYouModel
@{
    ViewData["Title"] = "Solicitud recibida";
}

<div class="cliente-page">
    <div class="cliente-card text-center py-5">
        <div class="success-icon mb-3">✓</div>
        <h1 class="property-title">¡Listo!</h1>
        <p class="text-muted mb-4">
            Recibimos tu solicitud para ver <strong>@Model.PropertyTitle</strong><br />
            <span class="small">@Model.Address</span>
        </p>
        <p class="mb-0">Te contactaremos pronto por WhatsApp para confirmar tu visita.</p>
    </div>
</div>
