@page
@model ErrorModel
@{
    ViewData["Title"] = "Ha ocurrido un error";
    Layout = "_ClienteLayout";
}

<div class="cliente-page">
    <div class="cliente-card text-center py-5">
        <h1 class="text-danger">Ha ocurrido un error</h1>
        <p class="text-muted mb-4">Ocurrió un error al procesar tu solicitud.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mb-0">
                <strong>ID de solicitud:</strong> <code>@Model.RequestId</code>
            </p>
        }
        <a href="/Apartamentos/Index" class="btn btn-primary mt-4">Volver al catálogo</a>
    </div>
</div>
