@page "/Apartamentos/Index"
@using ApartamentosRenta.Services
@model ApartamentosRenta.Pages.Apartamentos.IndexModel
@{
    ViewData["Title"] = "Buscar alquileres";
    var filters = Model.Filters;
}

<div class="catalog-page">
    <section class="catalog-hero-carousel-wrap" aria-label="Apartamentos destacados">
        <div class="catalog-hero-carousel" id="catalogHeroCarousel">
            @for (var i = 0; i < Model.HeroSlides.Count; i++)
            {
                var slide = Model.HeroSlides[i];
                <img src="@slide.Url"
                     alt="@slide.Alt"
                     class="catalog-carousel-photo @(i == 0 ? "is-active" : "")"
                     data-index="@i"
                     loading="@(i == 0 ? "eager" : "lazy")"
                     decoding="async" />
            }
            <div class="catalog-carousel-shade" aria-hidden="true"></div>
            <button type="button" class="catalog-carousel-nav catalog-carousel-prev" id="catalogCarouselPrev" aria-label="Foto anterior">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" class="catalog-carousel-nav catalog-carousel-next" id="catalogCarouselNext" aria-label="Foto siguiente">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
            </button>
            <div class="catalog-carousel-dots" id="catalogCarouselDots" role="tablist" aria-label="Fotos del carrusel">
                @for (var i = 0; i < Model.HeroSlides.Count; i++)
                {
                    <button type="button"
                            class="catalog-carousel-dot @(i == 0 ? "is-active" : "")"
                            data-index="@i"
                            role="tab"
                            aria-label="Foto @(i + 1)"
                            @(i == 0 ? "aria-selected=\"true\"" : "aria-selected=\"false\"")></button>
                }
            </div>
            <span class="catalog-carousel-counter" id="catalogCarouselCounter">1 / @Model.HeroSlides.Count</span>
        </div>
    </section>

    <section class="catalog-filters-wrap">
        <form method="get" class="catalog-filters card border-0 shadow-sm">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4">
                    <label class="form-label catalog-filter-label" for="searchQuery">Buscar</label>
                    <input type="search" id="searchQuery" name="Filters.Query" value="@filters.Query"
                           class="form-control catalog-input" placeholder="Ciudad, dirección, amenidades…" />
                </div>
                <div class="col-md-6 col-lg-2">
                    <label class="form-label catalog-filter-label" for="filterState">Estado</label>
                    <select id="filterState" name="Filters.State" class="form-select catalog-input">
                        <option value="">Todos los estados</option>
                        @foreach (var state in Model.StateOptions)
                        {
                            <option value="@state.Code" selected="@(filters.State == state.Code ? "selected" : null)">
                                @state.Name (@state.Count)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3 col-lg-1">
                    <label class="form-label catalog-filter-label" for="filterBeds">Habit.</label>
                    <select id="filterBeds" name="Filters.Bedrooms" class="form-select catalog-input">
                        <option value="">Cualquiera</option>
                        @for (var b = 1; b <= 4; b++)
                        {
                            <option value="@b" selected="@(filters.Bedrooms == b ? "selected" : null)">@b+</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label catalog-filter-label" for="filterMinRent">Alquiler mín.</label>
                    <input type="number" id="filterMinRent" name="Filters.MinRent" value="@filters.MinRent"
                           class="form-control catalog-input" min="0" step="50" placeholder="@Model.MinListingRent.ToString("N0")" />
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label catalog-filter-label" for="filterMaxRent">Alquiler máx.</label>
                    <input type="number" id="filterMaxRent" name="Filters.MaxRent" value="@filters.MaxRent"
                           class="form-control catalog-input" min="0" step="50" placeholder="@Model.MaxListingRent.ToString("N0")" />
                </div>
                <div class="col-6 col-md-3 col-lg-1">
                    <label class="form-label catalog-filter-label" for="filterSort">Orden</label>
                    <select id="filterSort" name="Filters.Sort" class="form-select catalog-input">
                        <option value="price-asc" selected="@(filters.Sort == "price-asc" ? "selected" : null)">Precio ↑</option>
                        <option value="price-desc" selected="@(filters.Sort == "price-desc" ? "selected" : null)">Precio ↓</option>
                        <option value="beds-desc" selected="@(filters.Sort == "beds-desc" ? "selected" : null)">Habitaciones</option>
                        <option value="newest" selected="@(filters.Sort == "newest" ? "selected" : null)">Más recientes</option>
                    </select>
                </div>
            </div>
            <div class="catalog-filter-actions">
                <button type="submit" class="btn btn-primary catalog-btn-search">Buscar listados</button>
                <a asp-page="/Apartamentos/Index" class="btn btn-outline-secondary">Limpiar filtros</a>
                <span class="catalog-results-count">
                    @Model.TotalFiltered.ToString("N0") resultado@(Model.TotalFiltered == 1 ? "" : "s")
                    @if (Model.TotalPages > 1)
                    {
                        <span> · Página @Model.Filters.Page de @Model.TotalPages</span>
                    }
                </span>
            </div>
        </form>
    </section>

    @if (!Model.Listings.Any())
    {
        <div class="catalog-empty card border-0 shadow-sm">
            <h2>No hay listados que coincidan con tu búsqueda</h2>
            <p>Prueba otro estado, rango de precio o palabra de búsqueda.</p>
            <a asp-page="/Apartamentos/Index" class="btn btn-primary">Ver todos los alquileres</a>
        </div>
    }
    else
    {
        <section class="catalog-grid" aria-label="Listados de alquiler">
            @foreach (var item in Model.Listings)
            {
                <article class="catalog-card">
                    <a href="@item.ScheduleUrl" class="catalog-card-media">
                        @if (!string.IsNullOrWhiteSpace(item.PhotoUrl))
                        {
                            <img src="@item.PhotoUrl" alt="@item.Titulo" loading="lazy"
                                 onerror="this.onerror=null;this.src='@PropertyCatalogHelper.FallbackPhotoUrl';" />
                        }
                        else
                        {
                            <div class="catalog-card-placeholder">Sin foto</div>
                        }
                        <span class="catalog-card-badge">@item.StateName</span>
                        <span class="catalog-card-verified">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                            Verificado
                        </span>
                    </a>
                    <div class="catalog-card-body">
                        <p class="catalog-card-location">@item.CityLabel</p>
                        <h2 class="catalog-card-title">
                            <a href="@item.ScheduleUrl">@item.Titulo</a>
                        </h2>
                        <p class="catalog-card-address">@item.Direccion</p>
                        <p class="catalog-card-price">$@item.PrecioMensual.ToString("N0")<span>/mes</span></p>
                        <div class="catalog-card-stats">
                            <span>@item.Habitaciones hab.</span>
                            <span>@item.Banos baños</span>
                            <span>@item.MetrosCuadrados.ToString("N0") pies²</span>
                        </div>
                        @if (item.AmenityTags.Any())
                        {
                            <div class="catalog-card-tags">
                                @foreach (var tag in item.AmenityTags)
                                {
                                    <span>@tag</span>
                                }
                            </div>
                        }
                        <div class="catalog-card-footer">
                            <span class="catalog-deposit-note">Depósito de visita desde $@item.DepositAmount.ToString("N0")</span>
                            <a href="@item.ScheduleUrl" class="btn btn-primary catalog-card-cta">Agendar visita</a>
                        </div>
                    </div>
                </article>
            }
        </section>

        @if (Model.TotalPages > 1)
        {
            <nav class="catalog-pagination" aria-label="Páginas de listados">
                @if (Model.Filters.Page > 1)
                {
                    <a class="catalog-page-link" href="@Model.BuildPageUrl(Model.Filters.Page - 1)">Anterior</a>
                }
                @{
                    var startPage = Math.Max(1, Model.Filters.Page - 2);
                    var endPage = Math.Min(Model.TotalPages, Model.Filters.Page + 2);
                }
                @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                {
                    <a class="catalog-page-link @(pageNumber == Model.Filters.Page ? "active" : "")"
                       href="@Model.BuildPageUrl(pageNumber)"
                       @(pageNumber == Model.Filters.Page ? "aria-current=\"true\"" : null)>@pageNumber</a>
                }
                @if (Model.Filters.Page < Model.TotalPages)
                {
                    <a class="catalog-page-link" href="@Model.BuildPageUrl(Model.Filters.Page + 1)">Siguiente</a>
                }
            </nav>
        }
    }

    <section class="catalog-trust" aria-label="Por qué confían en nosotros">
        <div class="catalog-trust-header">
            <p class="catalog-eyebrow">Proceso de alquiler confiable</p>
            <h2>Diseñado para dar confianza en cada paso</h2>
            <p>Desde tu primera búsqueda hasta la documentación firmada, Premier Property Hub mantiene el proceso profesional, seguro y transparente.</p>
        </div>
        <div class="catalog-trust-grid">
            <article class="catalog-trust-card">
                <div class="catalog-trust-icon catalog-trust-icon-blue" aria-hidden="true">🛡️</div>
                <h3>Listados verificados</h3>
                <p>Cada propiedad se revisa antes de publicarse. Sin spam ni anuncios falsos — solo hogares reales listos para visitar.</p>
            </article>
            <article class="catalog-trust-card">
                <div class="catalog-trust-icon catalog-trust-icon-green" aria-hidden="true">✓</div>
                <h3>Reserva segura de visita</h3>
                <p>Agenda una visita certificada de 30 minutos con depósito reembolsable y pasos claros.</p>
            </article>
            <article class="catalog-trust-card">
                <div class="catalog-trust-icon catalog-trust-icon-gold" aria-hidden="true">📜</div>
                <h3>Contratos oficiales</h3>
                <p>Acuerdos de arrendamiento digitales adaptados a cada propiedad con firma electrónica.</p>
            </article>
            <article class="catalog-trust-card">
                <div class="catalog-trust-icon catalog-trust-icon-purple" aria-hidden="true">🏷️</div>
                <h3>Sellos y estampillas</h3>
                <p>Paquetes de documentación oficial cuando se requiera — sellos, estampillas o ambos.</p>
            </article>
            <article class="catalog-trust-card">
                <div class="catalog-trust-icon catalog-trust-icon-teal" aria-hidden="true">🔒</div>
                <h3>Pagos seguros</h3>
                <p>Manejo del depósito vía Zelle con carga de comprobante y verificación administrativa.</p>
            </article>
            <article class="catalog-trust-card">
                <div class="catalog-trust-icon catalog-trust-icon-navy" aria-hidden="true">👤</div>
                <h3>Soporte con licencia</h3>
                <p>Nuestro equipo confirma las citas por teléfono o <a href="@Model.WhatsAppUrl" class="catalog-inline-wa" target="_blank" rel="noopener noreferrer">WhatsApp</a> una vez aprobado tu depósito.</p>
            </article>
        </div>

        <div class="catalog-seals-strip">
            <div class="catalog-seal">
                <span class="catalog-seal-ring">PREMIER</span>
                <small>Centro de propiedades</small>
            </div>
            <div class="catalog-seal">
                <span class="catalog-seal-ring">RE/MAX</span>
                <small>Red asociada</small>
            </div>
            <div class="catalog-seal">
                <span class="catalog-seal-ring">SSL</span>
                <small>Navegación segura</small>
            </div>
            <div class="catalog-seal">
                <span class="catalog-seal-ring">OFICIAL</span>
                <small>Contrato y sellos</small>
            </div>
            <div class="catalog-seal">
                <span class="catalog-seal-ring">REEMBOLSO</span>
                <small>Depósito de visita</small>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            const carousel = document.getElementById('catalogHeroCarousel');
            if (!carousel) return;

            const photos = carousel.querySelectorAll('.catalog-carousel-photo');
            const dots = carousel.querySelectorAll('.catalog-carousel-dot');
            const counter = document.getElementById('catalogCarouselCounter');
            const prevBtn = document.getElementById('catalogCarouselPrev');
            const nextBtn = document.getElementById('catalogCarouselNext');
            const total = photos.length;
            let index = 0;
            let timer = null;
            const intervalMs = 5000;

            function goTo(nextIndex) {
                if (!total) return;
                index = (nextIndex + total) % total;
                photos.forEach((img, i) => img.classList.toggle('is-active', i === index));
                dots.forEach((dot, i) => {
                    dot.classList.toggle('is-active', i === index);
                    dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
                });
                if (counter) counter.textContent = `${index + 1} / ${total}`;
            }

            function next() { goTo(index + 1); }
            function prev() { goTo(index - 1); }

            function startAuto() {
                stopAuto();
                timer = setInterval(next, intervalMs);
            }

            function stopAuto() {
                if (timer) clearInterval(timer);
                timer = null;
            }

            prevBtn?.addEventListener('click', () => { prev(); startAuto(); });
            nextBtn?.addEventListener('click', () => { next(); startAuto(); });
            dots.forEach(dot => {
                dot.addEventListener('click', () => {
                    const i = parseInt(dot.dataset.index, 10);
                    if (!Number.isNaN(i)) { goTo(i); startAuto(); }
                });
            });

            carousel.addEventListener('mouseenter', stopAuto);
            carousel.addEventListener('mouseleave', startAuto);

            let touchStartX = 0;
            carousel.addEventListener('touchstart', e => {
                touchStartX = e.changedTouches[0].screenX;
                stopAuto();
            }, { passive: true });
            carousel.addEventListener('touchend', e => {
                const diff = e.changedTouches[0].screenX - touchStartX;
                if (Math.abs(diff) > 50) goTo(index + (diff < 0 ? 1 : -1));
                startAuto();
            }, { passive: true });

            startAuto();
        })();
    </script>
}
