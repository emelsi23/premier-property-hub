@page "/furniture"
@model ApartamentosRenta.Pages.Furniture.IndexModel
@using ApartamentosRenta.Services
@{
    ViewData["Title"] = UiText.T("Furniture.Home");
    Layout = "/Pages/Shared/_FurnitureLayout.cshtml";
    var catImages = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["living-room"] = "https://images.pexels.com/photos/1571460/pexels-photo-1571460.jpeg?auto=compress&cs=tinysrgb&w=900",
        ["bedroom"] = "https://images.pexels.com/photos/1643383/pexels-photo-1643383.jpeg?auto=compress&cs=tinysrgb&w=900",
        ["dining"] = "https://images.pexels.com/photos/1080721/pexels-photo-1080721.jpeg?auto=compress&cs=tinysrgb&w=900",
        ["home-office"] = "https://images.pexels.com/photos/374870/pexels-photo-374870.jpeg?auto=compress&cs=tinysrgb&w=900",
        ["outdoor"] = "https://images.pexels.com/photos/210604/pexels-photo-210604.jpeg?auto=compress&cs=tinysrgb&w=900",
        ["mattresses"] = "https://images.pexels.com/photos/1457842/pexels-photo-1457842.jpeg?auto=compress&cs=tinysrgb&w=900",
        ["sale"] = "https://images.pexels.com/photos/1866149/pexels-photo-1866149.jpeg?auto=compress&cs=tinysrgb&w=900"
    };

    var heroSlides = new (string Img, string Eyebrow, string Title, string Text, string Cta, string Href)[]
    {
        ("https://images.pexels.com/photos/1571460/pexels-photo-1571460.jpeg?auto=compress&cs=tinysrgb&w=1800",
            UiText.T("Furniture.HeroLivingEyebrow"), UiText.T("Furniture.HeroLivingTitle"),
            UiText.T("Furniture.HeroLivingText"),
            UiText.T("Furniture.HeroLivingCta"), "/furniture/living-room"),
        ("https://images.pexels.com/photos/1643383/pexels-photo-1643383.jpeg?auto=compress&cs=tinysrgb&w=1800",
            UiText.T("Furniture.HeroBedroomEyebrow"), UiText.T("Furniture.HeroBedroomTitle"),
            UiText.T("Furniture.HeroBedroomText"),
            UiText.T("Furniture.HeroBedroomCta"), "/furniture/bedroom"),
        ("https://images.pexels.com/photos/1080721/pexels-photo-1080721.jpeg?auto=compress&cs=tinysrgb&w=1800",
            UiText.T("Furniture.HeroDiningEyebrow"), UiText.T("Furniture.HeroDiningTitle"),
            UiText.T("Furniture.HeroDiningText"),
            UiText.T("Furniture.HeroDiningCta"), "/furniture/dining")
    };
}

<div class="iw-marquee" aria-hidden="true">
    <div class="iw-marquee-track">
        <span>@UiText.T("Furniture.Marquee1")</span>
        <span>·</span>
        <span>@UiText.T("Furniture.Marquee2")</span>
        <span>·</span>
        <span>Ironwood Home Furniture Co.</span>
        <span>·</span>
        <span>@UiText.T("Furniture.Marquee1")</span>
        <span>·</span>
        <span>@UiText.T("Furniture.Marquee2")</span>
        <span>·</span>
        <span>Ironwood Home Furniture Co.</span>
    </div>
</div>

<section class="iw-hero-carousel" data-hero-carousel>
    @for (var i = 0; i < heroSlides.Length; i++)
    {
        var s = heroSlides[i];
        <div class="iw-hero-slide @(i == 0 ? "is-active" : null)" style="--hero-img:url('@s.Img')">
            <div class="iw-hero-content">
                <p class="iw-hero-eyebrow">@s.Eyebrow</p>
                <h1>@s.Title</h1>
                <p>@s.Text</p>
                <div class="iw-hero-actions">
                    <a class="iw-hero-cta" href="@s.Href">@s.Cta</a>
                    <a class="iw-hero-cta iw-hero-cta-ghost" href="/furniture/sale">@UiText.T("Furniture.ViewSale")</a>
                </div>
            </div>
        </div>
    }
    <button type="button" class="iw-hero-nav iw-hero-prev" data-hero-prev aria-label="@UiText.T("Furniture.Prev")">‹</button>
    <button type="button" class="iw-hero-nav iw-hero-next" data-hero-next aria-label="@UiText.T("Furniture.Next")">›</button>
    <div class="iw-hero-dots">
        @for (var i = 0; i < heroSlides.Length; i++)
        {
            <button type="button" data-hero-dot class="@(i == 0 ? "is-active" : null)" aria-label="Slide @(i + 1)"></button>
        }
    </div>
</section>

<section class="iw-trust">
    <div class="iw-trust-item">
        <strong>@UiText.T("Furniture.TrustCurated")</strong>
        <span>@UiText.T("Furniture.TrustCuratedBody")</span>
    </div>
    <div class="iw-trust-item">
        <strong>@UiText.T("Furniture.TrustWa")</strong>
        <span>@UiText.T("Furniture.TrustWaBody")</span>
    </div>
    <div class="iw-trust-item">
        <strong>@UiText.T("Furniture.TrustLinks")</strong>
        <span>@UiText.T("Furniture.TrustLinksBody")</span>
    </div>
    <div class="iw-trust-item">
        <strong>@UiText.T("Furniture.TrustRooms")</strong>
        <span>@UiText.T("Furniture.TrustRoomsBody")</span>
    </div>
</section>

<section class="iw-section">
    <div class="iw-section-head">
        <div>
            <p class="iw-kicker">@UiText.T("Furniture.Collections")</p>
            <h2 class="iw-section-title">@UiText.T("Furniture.ShopByRoom")</h2>
        </div>
    </div>
    <div class="iw-carousel" data-carousel>
        <button type="button" class="iw-carousel-edge iw-carousel-edge-prev" data-carousel-prev aria-label="@UiText.T("Furniture.Prev")">‹</button>
        <div class="iw-carousel-viewport">
            <div class="iw-carousel-track" data-carousel-track>
                @foreach (var c in Model.Categories)
                {
                    var img = catImages.GetValueOrDefault(c.Slug) ?? catImages["living-room"];
                    <a class="iw-cat-slide" href="/furniture/@c.Slug" style="--iw-cat-img:url('@img')">
                        <span class="iw-cat-slide-label">@FurnitureLocalizer.CategoryName(c)</span>
                        <span class="iw-cat-slide-cta">@UiText.T("Furniture.Explore")</span>
                    </a>
                }
            </div>
        </div>
        <button type="button" class="iw-carousel-edge iw-carousel-edge-next" data-carousel-next aria-label="@UiText.T("Furniture.Next")">›</button>
    </div>
</section>

@if (Model.Featured.Count > 0)
{
    <section class="iw-section">
        <div class="iw-section-head">
            <div>
                <p class="iw-kicker">@UiText.T("Furniture.EditorsPicks")</p>
                <h2 class="iw-section-title">@UiText.T("Furniture.FeaturedPieces")</h2>
            </div>
            <a class="iw-section-link" href="/furniture/living-room">@UiText.T("Furniture.ShopAllLiving")</a>
        </div>
        <div class="iw-carousel" data-carousel>
            <button type="button" class="iw-carousel-edge iw-carousel-edge-prev" data-carousel-prev aria-label="@UiText.T("Furniture.Prev")">‹</button>
            <div class="iw-carousel-viewport">
                <div class="iw-carousel-track" data-carousel-track>
                    @foreach (var p in Model.Featured)
                    {
                        @await Html.PartialAsync("_ProductCard", p)
                    }
                </div>
            </div>
            <button type="button" class="iw-carousel-edge iw-carousel-edge-next" data-carousel-next aria-label="@UiText.T("Furniture.Next")">›</button>
        </div>
    </section>
}

@if (Model.OnSale.Count > 0)
{
    <section class="iw-section iw-section-sale">
        <div class="iw-section-head">
            <div>
                <p class="iw-kicker iw-kicker-sale">@UiText.T("Furniture.LimitedOffers")</p>
                <h2 class="iw-section-title">@UiText.T("Furniture.OnSaleNow")</h2>
            </div>
            <a class="iw-section-link" href="/furniture/sale">@UiText.T("Furniture.ViewSaleArrow")</a>
        </div>
        <div class="iw-carousel" data-carousel>
            <button type="button" class="iw-carousel-edge iw-carousel-edge-prev" data-carousel-prev aria-label="@UiText.T("Furniture.Prev")">‹</button>
            <div class="iw-carousel-viewport">
                <div class="iw-carousel-track" data-carousel-track>
                    @foreach (var p in Model.OnSale)
                    {
                        @await Html.PartialAsync("_ProductCard", p)
                    }
                </div>
            </div>
            <button type="button" class="iw-carousel-edge iw-carousel-edge-next" data-carousel-next aria-label="@UiText.T("Furniture.Next")">›</button>
        </div>
    </section>
}

@if (Model.Newest.Count > 0)
{
    <section class="iw-section">
        <div class="iw-section-head">
            <div>
                <p class="iw-kicker">@UiText.T("Furniture.JustIn")</p>
                <h2 class="iw-section-title">@UiText.T("Furniture.NewArrivals")</h2>
            </div>
        </div>
        <div class="iw-carousel" data-carousel>
            <button type="button" class="iw-carousel-edge iw-carousel-edge-prev" data-carousel-prev aria-label="@UiText.T("Furniture.Prev")">‹</button>
            <div class="iw-carousel-viewport">
                <div class="iw-carousel-track" data-carousel-track>
                    @foreach (var p in Model.Newest)
                    {
                        @await Html.PartialAsync("_ProductCard", p)
                    }
                </div>
            </div>
            <button type="button" class="iw-carousel-edge iw-carousel-edge-next" data-carousel-next aria-label="@UiText.T("Furniture.Next")">›</button>
        </div>
    </section>
}

<section class="iw-banner">
    <div class="iw-banner-copy">
        <p class="iw-kicker">@UiText.T("Furniture.HowItWorks")</p>
        <h2>@UiText.T("Furniture.BannerTitle")</h2>
        <p>@UiText.T("Furniture.BannerBody")</p>
    </div>
    <a class="iw-hero-cta" href="/furniture/living-room">@UiText.T("Furniture.StartShopping")</a>
</section>
