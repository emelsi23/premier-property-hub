@page "/furniture/{category}"
@model ApartamentosRenta.Pages.Furniture.CategoryModel
@{
    ViewData["Title"] = Model.Category?.Name ?? "Categoría";
    Layout = "/Pages/Shared/_FurnitureLayout.cshtml";
}

@if (Model.Category is null)
{
    <div class="iw-empty">Categoría no encontrada.</div>
}
else
{
    <p class="iw-breadcrumb">
        <a href="/furniture">Home</a> / <a href="/furniture">Furniture</a> / <strong>@Model.Category.Name</strong>
    </p>

    <div class="iw-toolbar">
        <div>
            <p class="iw-kicker">Category</p>
            <h1>@Model.Category.Name</h1>
            <p class="iw-count">@Model.Products.Count items available</p>
        </div>
        <form method="get" class="iw-sort-wrap">
            <label for="sort">Sort by</label>
            <select class="iw-sort" id="sort" name="sort" onchange="this.form.submit()">
                @{
                    var options = new (string Value, string Label)[]
                    {
                        ("featured", "Featured"),
                        ("price-asc", "Price: Low to High"),
                        ("price-desc", "Price: High to Low"),
                        ("name", "Product Name")
                    };
                }
                @foreach (var opt in options)
                {
                    if (Model.Sort == opt.Value)
                    {
                        <option value="@opt.Value" selected>@opt.Label</option>
                    }
                    else
                    {
                        <option value="@opt.Value">@opt.Label</option>
                    }
                }
            </select>
        </form>
    </div>

    <div class="iw-layout-shop">
        <aside class="iw-side">
            <h2>Shop rooms</h2>
            <ul class="iw-side-list">
                @foreach (var c in Model.AllCategories)
                {
                    <li>
                        <a class="@(c.Slug == Model.Category.Slug ? "is-active" : null)" href="/furniture/@c.Slug">@c.Name</a>
                    </li>
                }
            </ul>
        </aside>

        <div>
            @if (Model.Products.Count == 0)
            {
                <div class="iw-empty">No hay productos en esta categoría todavía.</div>
            }
            else
            {
                <div class="iw-product-grid">
                    @foreach (var p in Model.Products)
                    {
                        @await Html.PartialAsync("_ProductCard", p)
                    }
                </div>
            }
        </div>
    </div>
}
