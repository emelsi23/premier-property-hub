@page "/furniture/item/{slug}"
@model ApartamentosRenta.Pages.Furniture.ItemModel
@using ApartamentosRenta.Services
@{
    ViewData["Title"] = Model.Product?.Title ?? UiText.T("Furniture.ProductNotFound");
    Layout = "/Pages/Shared/_FurnitureLayout.cshtml";
}

@if (Model.Product is null)
{
    <div class="iw-empty">@UiText.T("Furniture.ProductNotFound")</div>
}
else
{
    var p = Model.Product;
    var photos = p.Photos.OrderBy(x => x.SortOrder).ToList();
    var main = photos.FirstOrDefault()?.Url ?? "/images/ironwood-logo.jpg";
    var onSale = p.CompareAtPrice is > 0 && p.CompareAtPrice > p.Price;

    <p class="iw-breadcrumb">
        <a href="/furniture">@UiText.T("Furniture.Home")</a>
        @if (p.Category is not null)
        {
            <text> / </text><a href="/furniture/@p.Category.Slug">@FurnitureLocalizer.CategoryName(p.Category)</a>
        }
        <text> / <strong>@p.Title</strong></text>
    </p>

    <article class="iw-detail">
        <div class="iw-gallery">
            <div class="iw-gallery-wrap">
                <div class="iw-gallery-main">
                    <img id="iwMainPhoto" class="iw-fade" src="@main" alt="@p.Title" />
                </div>
                @if (photos.Count > 1)
                {
                    <button type="button" class="iw-gallery-nav prev" data-gallery-prev aria-label="@UiText.T("Furniture.PrevPhoto")">‹</button>
                    <button type="button" class="iw-gallery-nav next" data-gallery-next aria-label="@UiText.T("Furniture.NextPhoto")">›</button>
                }
            </div>
            @if (photos.Count > 1)
            {
                <div class="iw-thumbs" id="iwThumbs">
                    @for (var i = 0; i < photos.Count; i++)
                    {
                        <button type="button" class="@(i == 0 ? "is-active" : null)" data-src="@photos[i].Url" aria-label="@UiText.T("Furniture.PhotoN", i + 1)">
                            <img src="@photos[i].Url" alt="" />
                        </button>
                    }
                </div>
            }
        </div>

        <div class="iw-detail-panel">
            @if (onSale)
            {
                <span class="iw-badge-sale">@UiText.T("Furniture.Sale")</span>
            }
            <h1>@p.Title</h1>
            <p class="iw-sku">@UiText.T("Furniture.Model"): @(string.IsNullOrWhiteSpace(p.Sku) ? "—" : p.Sku)</p>
            <div class="iw-price-row">
                @if (onSale)
                {
                    <span class="iw-price-compare">$@p.CompareAtPrice!.Value.ToString("N2")</span>
                    <span class="iw-price">$@p.Price.ToString("N2")</span>
                }
                else
                {
                    <span class="iw-price">$@p.Price.ToString("N2")</span>
                }
            </div>
            @{
                var shortText = FurnitureLocalizer.Short(p);
                var descText = FurnitureLocalizer.Description(p);
            }
            @if (!string.IsNullOrWhiteSpace(shortText))
            {
                <p class="iw-detail-desc" style="margin-bottom:0.5rem;color:#1c1917;font-weight:600;">@shortText</p>
            }
            <p class="iw-detail-desc">@descText</p>

            <a class="iw-wa-btn" href="@Model.WhatsAppUrl" target="_blank" rel="noopener noreferrer">
                @UiText.T("Furniture.OrderWhatsApp")
            </a>
            <p class="iw-wa-note">@UiText.T("Furniture.WaNote")</p>
        </div>
    </article>
}
