@using ApartamentosRenta.Models
@model BrandLockupOptions
@{
    var options = Model ?? new BrandLockupOptions();
    var variantClass = string.IsNullOrEmpty(options.Variant) ? "" : $"brand-lockup--{options.Variant}";
}

@if (options.LinkToCatalog)
{
    <a class="brand-lockup-link" asp-page="/Apartamentos/Index" aria-label="Premier Property Hub by RE/MAX — catálogo de alquileres">
        <div class="brand-lockup @(variantClass)">
            <span class="brand-lockup-name">Premier Property Hub</span>
            <span class="brand-lockup-by">
                <span class="brand-lockup-by-text">by</span>
                <img src="~/images/remax-logo.svg" alt="RE/MAX" class="brand-lockup-remax" asp-append-version="true" />
            </span>
        </div>
    </a>
}
else
{
    <div class="brand-lockup @(variantClass)">
        <span class="brand-lockup-name">Premier Property Hub</span>
        <span class="brand-lockup-by">
            <span class="brand-lockup-by-text">by</span>
            <img src="~/images/remax-logo.svg" alt="RE/MAX" class="brand-lockup-remax" asp-append-version="true" />
        </span>
    </div>
}
