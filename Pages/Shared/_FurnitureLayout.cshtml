@using ApartamentosRenta.Data
@using ApartamentosRenta.Services
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@{
    var categories = await Db.FurnitureCategories.AsNoTracking()
        .Where(c => c.IsActive)
        .OrderBy(c => c.SortOrder)
        .ToListAsync();
    var path = Context.Request.Path.Value ?? "";
    var htmlLang = SiteCulture.Current;
}
<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] · Ironwood Home Furniture Co.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/furniture.css" asp-append-version="true" />
</head>
<body class="iw-body">
    <div class="iw-topbar">
        <div class="iw-topbar-inner">
            <span>@UiText.T("Furniture.Topbar")</span>
            <span>Ironwood Home Furniture Co.</span>
        </div>
    </div>

    <header class="iw-header">
        <div class="iw-header-inner">
            <div class="iw-header-row">
                <a class="iw-brand" href="/furniture" aria-label="Ironwood Home Furniture Co.">
                    <img src="~/images/ironwood-logo.jpg" alt="Ironwood Home Furniture Co." class="iw-logo" asp-append-version="true" />
                    <span class="iw-brand-text">
                        <strong>IRONWOOD HOME</strong>
                        <small>Furniture Co.</small>
                    </span>
                </a>
                <div class="iw-header-actions">
                    <partial name="_LanguageToggle" />
                    <span class="iw-chip">@UiText.T("Furniture.Chip")</span>
                </div>
            </div>
            <div class="iw-nav-wrap">
                <nav class="iw-nav" aria-label="@UiText.T("Furniture.Categories")">
                    <a class="iw-nav-link @(path.Equals("/furniture", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/furniture">@UiText.T("Furniture.Home")</a>
                    @foreach (var c in categories)
                    {
                        var active = path.Contains($"/furniture/{c.Slug}", StringComparison.OrdinalIgnoreCase)
                            && !path.Contains("/furniture/item/", StringComparison.OrdinalIgnoreCase);
                        <a class="iw-nav-link @(active ? "is-active" : "")" href="/furniture/@c.Slug">@FurnitureLocalizer.CategoryName(c)</a>
                    }
                </nav>
            </div>
        </div>
    </header>

    <main class="iw-main">
        @RenderBody()
    </main>

    <footer class="iw-footer">
        <div class="iw-footer-inner">
            <div class="iw-footer-grid">
                <div class="iw-footer-brand">
                    <img src="~/images/ironwood-logo.jpg" alt="" class="iw-logo iw-logo-sm" asp-append-version="true" />
                    <div>
                        <strong>Ironwood Home Furniture Co.</strong>
                        <p>@UiText.T("Furniture.FooterBlurb")</p>
                    </div>
                </div>
                <div class="iw-footer-col">
                    <h3>@UiText.T("Furniture.Shop")</h3>
                    @foreach (var c in categories.Take(5))
                    {
                        <a href="/furniture/@c.Slug">@FurnitureLocalizer.CategoryName(c)</a>
                    }
                </div>
                <div class="iw-footer-col">
                    <h3>@UiText.T("Furniture.Contact")</h3>
                    <p>@UiText.T("Furniture.FooterContact")</p>
                </div>
            </div>
            <p class="iw-footer-copy">&copy; @DateTime.UtcNow.Year Ironwood Home Furniture Co. @UiText.T("Furniture.Rights")</p>
        </div>
    </footer>
    <script src="~/js/furniture.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
