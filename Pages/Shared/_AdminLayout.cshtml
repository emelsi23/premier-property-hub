@using ApartamentosRenta.Services
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isProperties = currentPage == "/Admin/Index" || currentPage.StartsWith("/Admin/Create", StringComparison.Ordinal) || currentPage.StartsWith("/Admin/Edit", StringComparison.Ordinal) || currentPage.StartsWith("/Admin/Delete", StringComparison.Ordinal);
    var isAppointments = currentPage.StartsWith("/Admin/Appointments", StringComparison.OrdinalIgnoreCase);
    var isReservas = currentPage.Equals("/Admin/Reservas/Index", StringComparison.OrdinalIgnoreCase)
        || currentPage.Equals("/Admin/Reservas", StringComparison.OrdinalIgnoreCase);
    var isReservasPagos = currentPage.StartsWith("/Admin/Reservas/Pagos", StringComparison.OrdinalIgnoreCase);
    var isContract = currentPage.StartsWith("/Admin/Contract", StringComparison.OrdinalIgnoreCase);
    var isStampSeals = currentPage.StartsWith("/Admin/StampSeals", StringComparison.OrdinalIgnoreCase);
    var isAgents = currentPage.StartsWith("/Admin/Agents", StringComparison.OrdinalIgnoreCase);
    var displayName = User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? "Admin";
    var username = AdminUsers.CurrentUsername(User);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <header class="admin-topbar">
        <div class="admin-topbar-inner">
            <button class="admin-menu-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminNav" aria-controls="adminNav" aria-label="Abrir menú">
                <span></span><span></span><span></span>
            </button>
            <a class="admin-brand" asp-page="/Admin/Index">
                <span class="admin-brand-mark">PPH</span>
                <span class="admin-brand-text">
                    <strong>Premier Property Hub</strong>
                    <small>Admin</small>
                </span>
            </a>
            <div class="admin-user-chip" title="@username">
                <span class="admin-user-avatar">@(string.IsNullOrEmpty(displayName) ? "A" : displayName[0].ToString().ToUpperInvariant())</span>
                <span class="admin-user-name">@displayName</span>
            </div>
        </div>
    </header>

    <div class="offcanvas offcanvas-start admin-offcanvas" tabindex="-1" id="adminNav" aria-labelledby="adminNavLabel">
        <div class="offcanvas-header">
            <div>
                <h2 class="offcanvas-title h5 mb-0" id="adminNavLabel">Menú</h2>
                <div class="small text-muted">@displayName · @username</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
        </div>
        <div class="offcanvas-body admin-nav-body">
            <nav class="admin-nav">
                <p class="admin-nav-label">Compartido</p>
                <a class="admin-nav-link @(isProperties ? "active" : "")" asp-page="/Admin/Index">Propiedades</a>
                <a class="admin-nav-link @(isAgents ? "active" : "")" asp-page="/Admin/Agents/Index">Agentes</a>

                <p class="admin-nav-label">Su bandeja</p>
                <a class="admin-nav-link @(isAppointments ? "active" : "")" asp-page="/Admin/Appointments/Index">Citas</a>
                <a class="admin-nav-link @(isReservas ? "active" : "")" asp-page="/Admin/Reservas/Index">Reservas</a>
                <a class="admin-nav-link @(isReservasPagos ? "active" : "")" asp-page="/Admin/Reservas/Pagos">Pagos reserva</a>
                <a class="admin-nav-link @(isContract ? "active" : "")" asp-page="/Admin/Contract/Submissions">Firmas contrato</a>
                <a class="admin-nav-link @(isStampSeals ? "active" : "")" asp-page="/Admin/StampSeals/Submissions">Firmas estampillas</a>
            </nav>
            <form method="post" asp-page="/Admin/Logout" class="mt-auto pt-3">
                <button type="submit" class="btn btn-outline-secondary w-100">Cerrar sesión</button>
            </form>
        </div>
    </div>

    <aside class="admin-sidebar d-none d-lg-flex">
        <div class="admin-sidebar-head">
            <span class="admin-brand-mark">PPH</span>
            <div>
                <strong>Admin</strong>
                <small>@displayName</small>
            </div>
        </div>
        <nav class="admin-nav flex-grow-1">
            <p class="admin-nav-label">Compartido</p>
            <a class="admin-nav-link @(isProperties ? "active" : "")" asp-page="/Admin/Index">Propiedades</a>
            <a class="admin-nav-link @(isAgents ? "active" : "")" asp-page="/Admin/Agents/Index">Agentes</a>

            <p class="admin-nav-label">Su bandeja</p>
            <a class="admin-nav-link @(isAppointments ? "active" : "")" asp-page="/Admin/Appointments/Index">Citas</a>
            <a class="admin-nav-link @(isReservas ? "active" : "")" asp-page="/Admin/Reservas/Index">Reservas</a>
            <a class="admin-nav-link @(isReservasPagos ? "active" : "")" asp-page="/Admin/Reservas/Pagos">Pagos reserva</a>
            <a class="admin-nav-link @(isContract ? "active" : "")" asp-page="/Admin/Contract/Submissions">Firmas contrato</a>
            <a class="admin-nav-link @(isStampSeals ? "active" : "")" asp-page="/Admin/StampSeals/Submissions">Firmas estampillas</a>
        </nav>
        <form method="post" asp-page="/Admin/Logout" class="p-3">
            <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Cerrar sesión</button>
        </form>
    </aside>

    <main class="admin-main">
        <div class="admin-main-inner">
            @RenderBody()
        </div>
    </main>

    <nav class="admin-bottom-nav d-lg-none" aria-label="Accesos rápidos">
        <a class="@(isProperties ? "active" : "")" asp-page="/Admin/Index">
            <span>Props</span>Propiedades
        </a>
        <a class="@(isAppointments ? "active" : "")" asp-page="/Admin/Appointments/Index">
            <span>Citas</span>Visitas
        </a>
        <a class="@(isReservas ? "active" : "")" asp-page="/Admin/Reservas/Index">
            <span>Res</span>Reservas
        </a>
        <a class="@(isReservasPagos ? "active" : "")" asp-page="/Admin/Reservas/Pagos">
            <span>Pay</span>Pagos
        </a>
        <button type="button" data-bs-toggle="offcanvas" data-bs-target="#adminNav">
            <span>Menú</span>Más
        </button>
    </nav>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
