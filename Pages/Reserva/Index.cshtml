@page "/reserva"
@model ApartamentosRenta.Pages.Reserva.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Protocolo de Seguridad y Reserva";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] — Premier Property Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;1,9..40,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/reserva.css" asp-append-version="true" />
</head>
<body class="reserva-body">
    <div class="reserva-shell">
        <div class="reserva-doc">
            <header class="reserva-doc-header">
                <div class="reserva-brand-row">
                    <div class="reserva-brand-mark" aria-hidden="true">REMAX</div>
                    <div>
                        <p class="reserva-doc-brand">Premier Property Hub</p>
                        <p class="reserva-doc-by">By REMAX · Departamento Jurídico</p>
                    </div>
                </div>
                <p class="reserva-doc-code">Documento REMAX-ELITE-2026-V</p>
                <h1 class="reserva-doc-title">Protocolo de Seguridad y Reserva de Propiedad</h1>
                <p class="reserva-doc-lead">Complete este protocolo de forma segura. Su reserva queda protegida y el depósito es reembolsable según los términos. Al firmar, verificaremos su identidad con documento y selfie.</p>
            </header>

            <form id="reservaForm" class="reserva-form" novalidate>
                <section class="reserva-section">
                    <div class="reserva-section-head">
                        <span class="reserva-step">01</span>
                        <h2>Información del solicitante</h2>
                    </div>
                    <div class="reserva-grid">
                        <label class="reserva-field reserva-field-full">
                            <span>Nombre completo</span>
                            <input type="text" name="Input.NombreCompleto" id="nombreCompleto" maxlength="160" required autocomplete="name" placeholder="Como aparece en su ID" />
                        </label>
                        <label class="reserva-field">
                            <span>Teléfono</span>
                            <input type="tel" name="Input.Telefono" id="telefono" maxlength="14" placeholder="(555) 000-0000" required autocomplete="tel" />
                        </label>
                        <label class="reserva-field">
                            <span>Correo electrónico</span>
                            <input type="email" name="Input.Email" id="email" maxlength="256" required autocomplete="email" placeholder="correo@ejemplo.com" />
                        </label>
                        <label class="reserva-field">
                            <span>Fecha de visita</span>
                            <input type="date" name="Input.FechaVisita" id="fechaVisita" required />
                        </label>
                        <label class="reserva-field">
                            <span>Hora</span>
                            <input type="time" name="Input.HoraVisita" id="horaVisita" value="10:00" required />
                        </label>
                    </div>
                </section>

                <section class="reserva-section">
                    <div class="reserva-section-head">
                        <span class="reserva-step">02</span>
                        <h2>Requerimientos de residencia</h2>
                    </div>
                    <div class="reserva-grid">
                        <label class="reserva-field">
                            <span>Ocupantes totales</span>
                            <input type="number" name="Input.OcupantesTotales" id="ocupantes" min="1" max="20" value="1" required />
                        </label>
                        <label class="reserva-field">
                            <span>Cantidad de vehículos</span>
                            <input type="number" name="Input.CantidadVehiculos" id="vehiculos" min="0" max="10" value="0" required />
                        </label>
                        <div class="reserva-toggle-group">
                            <p class="reserva-toggle-label">¿Posee hijos?</p>
                            <div class="reserva-toggles">
                                <label class="reserva-toggle"><input type="radio" name="Input.PoseeHijos" value="true" /><span>Sí</span></label>
                                <label class="reserva-toggle"><input type="radio" name="Input.PoseeHijos" value="false" checked /><span>No</span></label>
                            </div>
                        </div>
                        <div class="reserva-toggle-group">
                            <p class="reserva-toggle-label">¿Posee mascotas?</p>
                            <div class="reserva-toggles">
                                <label class="reserva-toggle"><input type="radio" name="Input.PoseeMascotas" value="true" /><span>Sí</span></label>
                                <label class="reserva-toggle"><input type="radio" name="Input.PoseeMascotas" value="false" checked /><span>No</span></label>
                            </div>
                        </div>
                    </div>
                    <p class="reserva-note">Sus datos se tratan de forma confidencial y se utilizan únicamente para validar su perfil de arrendamiento de manera segura.</p>
                </section>

                <section class="reserva-section">
                    <div class="reserva-section-head">
                        <span class="reserva-step">03</span>
                        <h2>Términos del depósito de reserva</h2>
                    </div>
                    <div class="reserva-deposit">
                        <div class="reserva-deposit-amount">
                            <span>Depósito de reserva protegido</span>
                            <strong>$150.00 USD</strong>
                        </div>
                        <ul>
                            <li><strong>Garantía total de reembolso:</strong> si decide no continuar después de la visita, se le reembolsa el 100% del depósito.</li>
                            <li><strong>Crédito a su renta:</strong> si renta la propiedad, el 100% del depósito se aplica al primer mes — no pierde ese dinero.</li>
                            <li><strong>Política de inasistencia:</strong> cancelación o no-show sin aviso de 24 horas genera un cargo administrativo de $10.00 (reembolso $140.00).</li>
                            <li><strong>Reserva exclusiva y segura:</strong> mientras su cita esté activa, la propiedad no se ofrece a terceros.</li>
                            <li><strong>Proceso verificado REMAX:</strong> su depósito queda documentado y respaldado bajo nuestro protocolo de transparencia.</li>
                        </ul>
                        <div class="reserva-trust-row" aria-hidden="true">
                            <span>Depósito protegido</span>
                            <span>Reembolso garantizado</span>
                            <span>Proceso seguro</span>
                        </div>
                    </div>

                    <div class="reserva-confirm-ask">
                        <p class="reserva-confirm-ask-title">Confirmación de acuerdo</p>
                        <p class="reserva-confirm-ask-text">
                            ¿Está de acuerdo en proceder con el pago del depósito de <strong>$150.00 USD</strong> para reservar su cita de manera segura y exclusiva?
                        </p>
                        <div class="reserva-toggles" role="radiogroup" aria-label="Acuerdo de pago del depósito">
                            <label class="reserva-toggle">
                                <input type="radio" name="Input.AceptaPagoReserva" id="aceptaPagoSi" value="true" required />
                                <span>Sí, estoy de acuerdo</span>
                            </label>
                            <label class="reserva-toggle">
                                <input type="radio" name="Input.AceptaPagoReserva" id="aceptaPagoNo" value="false" />
                                <span>No por ahora</span>
                            </label>
                        </div>
                    </div>
                </section>

                <section class="reserva-section">
                    <div class="reserva-section-head">
                        <span class="reserva-step">04</span>
                        <h2>Declaración y firma</h2>
                    </div>
                    <p class="reserva-legal">
                        Este protocolo forma parte de los procedimientos administrativos de Premier Property Hub By REMAX, estructurados bajo principios de legalidad, transparencia y protección al cliente. Su información y depósito cuentan con respaldo documental; ningún pago se pierde fuera de las condiciones aquí estipuladas.
                    </p>
                    <p class="reserva-sign-label">Firma del solicitante</p>
                    <div class="reserva-pad">
                        <canvas id="signaturePad" width="600" height="180" aria-label="Pad de firma"></canvas>
                        <button type="button" class="reserva-clear-btn" id="clearSignature">Borrar firma</button>
                    </div>
                    <label class="reserva-accept">
                        <input type="checkbox" id="aceptaTerminos" required />
                        <span>He leído y acepto los términos del protocolo. Confirmo que la información proporcionada es verídica.</span>
                    </label>
                </section>

                <p id="formError" class="reserva-error" hidden></p>

                <button type="submit" class="reserva-submit" id="submitBtn">Firmar y continuar</button>
            </form>

            <footer class="reserva-doc-footer">
                <p>Premier Property Hub By REMAX © @DateTime.UtcNow.Year</p>
                <p>Documento amparado bajo normativas de transparencia inmobiliaria</p>
                <p>Proceso verificado · Depósito protegido · Gestión profesional</p>
            </footer>
        </div>
    </div>

    @* Modal ID + selfie *@
    <div class="reserva-overlay" id="identityModal" hidden>
        <div class="reserva-modal" role="dialog" aria-modal="true" aria-labelledby="identityTitle">
            <div class="reserva-modal-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><circle cx="9" cy="11" r="2.2" stroke="currentColor" stroke-width="1.6"/><path d="M5.5 16.5c.8-1.6 2-2.4 3.5-2.4s2.7.8 3.5 2.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M14 10h5M14 13h3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </div>
            <h2 id="identityTitle">Verificación de identidad</h2>
            <p class="reserva-modal-text">Para proteger su reserva, suba una foto clara de su <strong>documento de identidad junto con un selfie</strong> (usted sosteniendo su ID frente a la cámara). Este paso garantiza que la cita quede a su nombre de forma segura.</p>
            <ul class="reserva-modal-tips">
                <li>Buena iluminación, sin reflejos</li>
                <li>ID legible y rostro visible</li>
                <li>JPG o PNG · máx. 8 MB</li>
            </ul>
            <label class="reserva-upload" for="identityFile">
                <input type="file" id="identityFile" accept="image/jpeg,image/png,image/webp,image/gif" />
                <span class="reserva-upload-title" id="identityFileLabel">Seleccionar foto</span>
                <span class="reserva-upload-sub">Toque para elegir desde su galería o cámara</span>
            </label>
            <div class="reserva-preview" id="identityPreviewWrap" hidden>
                <img id="identityPreview" alt="Vista previa" />
            </div>
            <p id="identityError" class="reserva-error" hidden></p>
            <button type="button" class="reserva-submit" id="uploadIdentityBtn" disabled>Subir y confirmar</button>
        </div>
    </div>

    @* Modal confirmación *@
    <div class="reserva-overlay" id="confirmModal" hidden>
        <div class="reserva-modal reserva-modal-success" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
            <div class="reserva-success-check" aria-hidden="true">✓</div>
            <h2 id="confirmTitle">¡Reserva confirmada!</h2>
            <p id="confirmName" class="reserva-modal-text"></p>
            <p id="confirmVisit" class="reserva-modal-sub"></p>
            <p class="reserva-code-label">Código de confirmación</p>
            <p class="reserva-code" id="confirmCode"></p>
            <p class="reserva-modal-sub">Guarde este código. Lo necesitará para validar su visita y depósito.</p>
            <button type="button" class="reserva-submit" id="entendidoBtn">Entendido</button>
        </div>
    </div>

<script>
(() => {
    const form = document.getElementById('reservaForm');
    const formError = document.getElementById('formError');
    const canvas = document.getElementById('signaturePad');
    const ctx = canvas.getContext('2d');
    const identityModal = document.getElementById('identityModal');
    const confirmModal = document.getElementById('confirmModal');
    const identityFile = document.getElementById('identityFile');
    const identityFileLabel = document.getElementById('identityFileLabel');
    const identityPreviewWrap = document.getElementById('identityPreviewWrap');
    const identityPreview = document.getElementById('identityPreview');
    const identityError = document.getElementById('identityError');
    const uploadIdentityBtn = document.getElementById('uploadIdentityBtn');
    const entendidoBtn = document.getElementById('entendidoBtn');

    let drawing = false;
    let hasSignature = false;
    let publicToken = null;

    document.getElementById('telefono').addEventListener('input', (e) => {
        const digits = e.target.value.replace(/\D/g, '').slice(0, 10);
        let formatted = '';
        if (digits.length === 0) {
            formatted = '';
        } else if (digits.length <= 3) {
            // Keep open paren only — no forced ") " so backspace can clear area code
            formatted = `(${digits}`;
        } else if (digits.length <= 6) {
            formatted = `(${digits.slice(0, 3)}) ${digits.slice(3)}`;
        } else {
            formatted = `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
        }
        e.target.value = formatted;
    });

    const fecha = document.getElementById('fechaVisita');
    const tmr = new Date(); tmr.setDate(tmr.getDate() + 1);
    fecha.min = tmr.toISOString().slice(0, 10);
    if (!fecha.value) fecha.value = fecha.min;

    function resizeCanvas() {
        const ratio = Math.max(window.devicePixelRatio || 1, 1);
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width * ratio;
        canvas.height = rect.height * ratio;
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        ctx.strokeStyle = '#1a1a1b';
        ctx.lineWidth = 2.2;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
    }

    function getPoint(e) {
        const rect = canvas.getBoundingClientRect();
        const touch = e.touches?.[0] ?? e.changedTouches?.[0];
        return { x: (touch ? touch.clientX : e.clientX) - rect.left, y: (touch ? touch.clientY : e.clientY) - rect.top };
    }

    function startDraw(e) { e.preventDefault(); drawing = true; hasSignature = true; const p = getPoint(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); }
    function draw(e) { if (!drawing) return; e.preventDefault(); const p = getPoint(e); ctx.lineTo(p.x, p.y); ctx.stroke(); }
    function endDraw() { drawing = false; }
    function clearSignature() { ctx.clearRect(0, 0, canvas.width, canvas.height); hasSignature = false; }

    canvas.addEventListener('mousedown', startDraw);
    canvas.addEventListener('mousemove', draw);
    canvas.addEventListener('mouseup', endDraw);
    canvas.addEventListener('mouseleave', endDraw);
    canvas.addEventListener('touchstart', startDraw, { passive: false });
    canvas.addEventListener('touchmove', draw, { passive: false });
    canvas.addEventListener('touchend', endDraw);
    document.getElementById('clearSignature').addEventListener('click', clearSignature);
    window.addEventListener('resize', () => {
        const data = hasSignature ? canvas.toDataURL('image/png') : null;
        resizeCanvas();
        if (data) {
            const img = new Image();
            img.onload = () => { ctx.drawImage(img, 0, 0, canvas.getBoundingClientRect().width, canvas.getBoundingClientRect().height); hasSignature = true; };
            img.src = data;
        }
    });
    resizeCanvas();

    function showErr(el, msg) { el.hidden = false; el.textContent = msg; }
    function hideErr(el) { el.hidden = true; el.textContent = ''; }

    function openOverlay(el) {
        el.hidden = false;
        document.body.classList.add('reserva-modal-open');
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideErr(formError);
        if (!form.checkValidity()) { form.reportValidity(); return; }
        if (!document.getElementById('aceptaPagoSi')?.checked) {
            showErr(formError, 'Por favor confirme que está de acuerdo en proceder con el pago del depósito para reservar su cita.');
            document.querySelector('.reserva-confirm-ask')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }
        if (!hasSignature) { showErr(formError, 'Debe firmar el protocolo antes de continuar.'); return; }
        if (!document.getElementById('aceptaTerminos').checked) { showErr(formError, 'Debe aceptar los términos y condiciones.'); return; }

        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.textContent = 'Enviando…';

        const fd = new FormData(form);
        fd.set('Input.FirmaDataUrl', canvas.toDataURL('image/png'));
        fd.set('Input.AceptaTerminos', 'true');

        try {
            const res = await fetch(window.location.pathname, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: fd
            });
            const data = await res.json();
            if (!data.success) {
                showErr(formError, (data.errors || ['Error al guardar.']).join(' '));
                btn.disabled = false;
                btn.textContent = 'Firmar y continuar';
                return;
            }
            publicToken = data.token;
            openOverlay(identityModal);
        } catch {
            showErr(formError, 'Error de conexión. Intente de nuevo.');
            btn.disabled = false;
            btn.textContent = 'Firmar y continuar';
        }
    });

    identityFile.addEventListener('change', () => {
        hideErr(identityError);
        const file = identityFile.files?.[0];
        if (!file) {
            uploadIdentityBtn.disabled = true;
            identityPreviewWrap.hidden = true;
            identityFileLabel.textContent = 'Seleccionar foto';
            return;
        }
        identityFileLabel.textContent = file.name;
        uploadIdentityBtn.disabled = false;
        identityPreview.src = URL.createObjectURL(file);
        identityPreviewWrap.hidden = false;
    });

    uploadIdentityBtn.addEventListener('click', async () => {
        hideErr(identityError);
        const file = identityFile.files?.[0];
        if (!file || !publicToken) { showErr(identityError, 'Seleccione una imagen válida.'); return; }

        uploadIdentityBtn.disabled = true;
        uploadIdentityBtn.textContent = 'Subiendo…';

        const fd = new FormData();
        fd.append('token', publicToken);
        fd.append('identityDoc', file);

        try {
            const res = await fetch(`${window.location.pathname}?handler=UploadIdentity`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: fd
            });
            const data = await res.json();
            if (!data.success) {
                showErr(identityError, data.error || 'No se pudo subir el documento.');
                uploadIdentityBtn.disabled = false;
                uploadIdentityBtn.textContent = 'Subir y confirmar';
                return;
            }

            identityModal.hidden = true;
            document.getElementById('confirmName').textContent = data.nombre || '';
            document.getElementById('confirmVisit').textContent = data.fechaVisita ? `Visita: ${data.fechaVisita}` : '';
            document.getElementById('confirmCode').textContent = data.confirmationCode || '';
            openOverlay(confirmModal);
        } catch {
            showErr(identityError, 'Error de conexión. Intente de nuevo.');
            uploadIdentityBtn.disabled = false;
            uploadIdentityBtn.textContent = 'Subir y confirmar';
        }
    });

    // Keep confirmation modal open — no redirect
    entendidoBtn.addEventListener('click', (e) => {
        e.preventDefault();
        entendidoBtn.textContent = 'Código guardado ✓';
        entendidoBtn.disabled = true;
    });
})();
</script>
</body>
</html>
