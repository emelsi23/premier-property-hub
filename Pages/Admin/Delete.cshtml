@page "{id:int}"
@model ApartamentosRenta.Pages.Admin.DeleteModel
@{
    ViewData["Title"] = "Eliminar propiedad";
}

<h1 class="h3 mb-4 text-danger">Eliminar propiedad</h1>

<div class="alert alert-warning">
    ¿Eliminar <strong>@Model.Propiedad.Titulo</strong>? Esto también quitará sus fotos y citas.
</div>

<form method="post">
    <input type="hidden" asp-for="Propiedad.Id" />
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-page="Index" class="btn btn-link">Cancelar</a>
</form>
