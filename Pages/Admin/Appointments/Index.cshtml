@page
@using ApartamentosRenta.Models
@using ApartamentosRenta.Services
@model ApartamentosRenta.Pages.Admin.Appointments.IndexModel
@{
    ViewData["Title"] = "Citas";
    static string SiNo(bool value) => value ? "Sí" : "No";
    static string MetodoLabel(MetodoPagoCita? metodo) => metodo switch
    {
        MetodoPagoCita.Zelle => "Zelle",
        MetodoPagoCita.ApplePay => "Apple Pay",
        MetodoPagoCita.Efectivo => "Efectivo",
        _ => "—"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Citas de visita</h1>
        <p class="text-muted mb-0">Revisa solicitudes, comprobantes de pago y confirma visitas.</p>
    </div>
    <a asp-page="/Admin/Index" class="btn btn-outline-secondary">← Propiedades</a>
</div>

@if (!Model.Appointments.Any())
{
    <div class="alert alert-info">Aún no hay citas. Comparte un enlace de propiedad por WhatsApp para empezar.</div>
}
else
{
    <div class="table-responsive card shadow-sm border-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Cliente</th>
                    <th>Propiedad</th>
                    <th>Visita</th>
                    <th>Pago</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model.Appointments)
                {
                    var detailsId = $"details-{appointment.Id}";
                    <tr>
                        <td>
                            <strong>@appointment.NombreCompleto</strong><br />
                            <a href="mailto:@appointment.Email" class="small">@appointment.Email</a><br />
                            <a href="https://wa.me/@(new string(appointment.Telefono.Where(char.IsDigit).ToArray()))" target="_blank" class="small">@appointment.Telefono</a><br />
                            <span class="small text-muted">SSN: @(string.IsNullOrWhiteSpace(appointment.SsnItin) ? "—" : appointment.SsnItin) · Nac.: @appointment.FechaNacimiento.ToString("dd/MM/yyyy")</span>
                        </td>
                        <td>
                            @appointment.Propiedad.Titulo<br />
                            <span class="small text-muted">@appointment.Propiedad.Direccion</span>
                        </td>
                        <td>
                            @appointment.FechaHora.ToString("dd/MM/yyyy HH:mm")
                            @if (!string.IsNullOrWhiteSpace(appointment.CodigoPostal))
                            {
                                <div class="small text-muted">ZIP: @appointment.CodigoPostal</div>
                            }
                        </td>
                        <td>
                            @if (appointment.PaymentProofData is { Length: > 0 })
                            {
                                <a asp-page-handler="PaymentProof" asp-route-id="@appointment.Id" target="_blank" class="d-inline-block">
                                    <img src="@Url.Page(null, "PaymentProof", new { id = appointment.Id })"
                                         alt="Comprobante de pago"
                                         class="payment-proof-thumb" />
                                </a>
                                @if (appointment.PaymentProofUploadedAt.HasValue)
                                {
                                    <div class="small text-muted">@appointment.PaymentProofUploadedAt.Value.ToString("dd/MM/yyyy HH:mm") UTC</div>
                                }
                            }
                            else
                            {
                                <span class="small text-muted">Depósito: $@VisitDepositSettings.GetAmount(appointment.Propiedad).ToString("N0")</span>
                            }
                            @if (appointment.MetodoPago.HasValue)
                            {
                                <div class="small text-muted">@MetodoLabel(appointment.MetodoPago)</div>
                            }
                        </td>
                        <td>
                            @switch (appointment.Estado)
                            {
                                case EstadoCita.Pendiente:
                                case EstadoCita.EsperandoDeposito:
                                    <span class="badge bg-warning text-dark">Esperando depósito</span>
                                    break;
                                case EstadoCita.EsperandoConfirmacion:
                                    <span class="badge bg-info text-dark">Esperando confirmación</span>
                                    break;
                                case EstadoCita.Confirmada:
                                    <span class="badge bg-success">Confirmada</span>
                                    break;
                                case EstadoCita.Cancelada:
                                    <span class="badge bg-secondary">Cancelada</span>
                                    break;
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary mb-1" data-bs-toggle="collapse" data-bs-target="#@detailsId">
                                Detalles
                            </button>
                            @if (appointment.Estado == EstadoCita.EsperandoConfirmacion)
                            {
                                <form method="post" asp-page-handler="Confirm" asp-route-id="@appointment.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">Confirmar visita</button>
                                </form>
                            }
                            @if (appointment.Estado is not EstadoCita.Confirmada and not EstadoCita.Cancelada)
                            {
                                <form method="post" asp-page-handler="Cancel" asp-route-id="@appointment.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                                </form>
                            }
                        </td>
                    </tr>
                    <tr class="collapse-row">
                        <td colspan="6" class="p-0 border-0">
                            <div class="collapse" id="@detailsId">
                                <div class="appointment-details-panel">
                                    <div class="row g-3 small">
                                        <div class="col-md-4"><strong>Ciudadano EE. UU.</strong><br />@SiNo(appointment.EsCiudadanoAmericano)</div>
                                        <div class="col-md-4"><strong>Personas en unidad</strong><br />@appointment.PersonasEnUnidad</div>
                                        <div class="col-md-4"><strong>Duración del contrato</strong><br />@(appointment.DuracionContratoDeseada ?? "—")</div>
                                        <div class="col-md-4"><strong>Mudanza temprana</strong><br />@(appointment.FechaMudanzaTemprana?.ToString("dd/MM/yyyy") ?? "—")</div>
                                        <div class="col-md-4"><strong>Fuma</strong><br />@SiNo(appointment.Fuma)</div>
                                        <div class="col-md-4"><strong>Mascotas</strong><br />@SiNo(appointment.TieneMascotas)</div>
                                        <div class="col-md-4"><strong>Empleado</strong><br />@SiNo(appointment.EmpleadoActualmente)</div>
                                        <div class="col-md-4"><strong>Empleador</strong><br />@(appointment.NombreCompania ?? "—")</div>
                                        <div class="col-md-4"><strong>Salario</strong><br />@(appointment.Salario.HasValue ? $"${appointment.Salario:N0}" : "—")</div>
                                        <div class="col-md-4"><strong>Fondos disponibles</strong><br />@(appointment.DisponibleParaAsegurar.HasValue ? $"${appointment.DisponibleParaAsegurar:N0}" : "—")</div>
                                        <div class="col-md-4"><strong>Acepta depósito reserva</strong><br />@SiNo(appointment.AceptaDepositoReserva)</div>
                                        <div class="col-md-4"><strong>Pagará visita certificada</strong><br />@SiNo(appointment.PagaraCitaCertificada)</div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
