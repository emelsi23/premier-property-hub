@model ApartamentosRenta.Pages.Admin.PropertyInput

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Ciudad" class="form-label"></label>
        <input asp-for="Ciudad" class="form-control" />
        <span asp-validation-for="Ciudad" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Direccion" class="form-label"></label>
        <input asp-for="Direccion" class="form-control" placeholder="ej. 250 Reforma Ave, Juarez District" />
        <div class="form-text">La dirección genera el enlace: /property/250-reforma-ave-juarez-district</div>
        <span asp-validation-for="Direccion" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="PrecioMensual" class="form-label"></label>
        <input asp-for="PrecioMensual" class="form-control" type="number" step="100" />
        <span asp-validation-for="PrecioMensual" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Habitaciones" class="form-label"></label>
        <input asp-for="Habitaciones" class="form-control" type="number" />
    </div>
    <div class="col-md-3">
        <label asp-for="Banos" class="form-label"></label>
        <input asp-for="Banos" class="form-control" type="number" />
    </div>
    <div class="col-md-3">
        <label asp-for="MetrosCuadrados" class="form-label"></label>
        <input asp-for="MetrosCuadrados" class="form-control" type="number" step="0.1" />
    </div>
    <div class="col-12">
        @{
            var existingPhotos = Model.ParseFotoUrls().ToList();
        }
        <label class="form-label">Fotos de la publicación</label>
        @if (existingPhotos.Count > 0)
        {
            <div class="d-flex flex-wrap gap-2 mb-2 property-photo-preview">
                @foreach (var photoUrl in existingPhotos)
                {
                    <img src="@photoUrl" alt="Foto actual" class="rounded border admin-thumb" width="96" height="72" style="object-fit:cover;" />
                }
            </div>
            <p class="form-text">Quita URLs del cuadro de abajo para eliminar fotos existentes.</p>
        }
        <label class="form-label fw-normal small text-muted">Subir imágenes desde tu computadora</label>
        <input type="file" name="FotoUploads" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" multiple />
        <div class="form-text">JPG, PNG, WEBP o GIF. Máximo 5 MB cada una. Puedes seleccionar varias.</div>
        <span class="text-danger small" data-valmsg-for="FotoUploads" data-valmsg-replace="true"></span>
        <label asp-for="FotosUrls" class="form-label mt-3"></label>
        <textarea asp-for="FotosUrls" class="form-control font-monospace" rows="4" placeholder="https://...&#10;https://..."></textarea>
        <div class="form-text">Opcional: una URL externa por línea, además de las imágenes subidas.</div>
        <span asp-validation-for="FotosUrls" class="text-danger"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Amenidades" class="form-label"></label>
        <input asp-for="Amenidades" class="form-control" placeholder="Estacionamiento, Gimnasio, Seguridad 24h" />
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check mb-2">
            <input asp-for="Disponible" class="form-check-input" type="checkbox" />
            <label asp-for="Disponible" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-12">
        <hr class="my-1" />
        <h2 class="h6 text-muted mb-3">Depósito Zelle (se muestra tras aprobación)</h2>
    </div>
    <div class="col-md-4">
        <label asp-for="DepositAmount" class="form-label"></label>
        <input asp-for="DepositAmount" class="form-control" type="number" min="1" step="1" />
        <div class="form-text">En solicitud, contrato y paso de depósito Zelle.</div>
        <span asp-validation-for="DepositAmount" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="StampsAmount" class="form-label"></label>
        <input asp-for="StampsAmount" class="form-control" type="number" min="1" step="1" />
        <div class="form-text">Tarifa solo estampillas en el acuerdo de estampillas y sellos.</div>
        <span asp-validation-for="StampsAmount" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="SealsAmount" class="form-label"></label>
        <input asp-for="SealsAmount" class="form-control" type="number" min="1" step="1" />
        <div class="form-text">Tarifa solo sellos en el acuerdo de estampillas y sellos.</div>
        <span asp-validation-for="SealsAmount" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ZelleDisplayName" class="form-label"></label>
        <input asp-for="ZelleDisplayName" class="form-control" placeholder="Premier Property Hub" />
    </div>
    <div class="col-md-4">
        <label asp-for="ZelleContact" class="form-label"></label>
        <input asp-for="ZelleContact" class="form-control" placeholder="pagos@email.com" />
        <div class="form-text">Email o teléfono Zelle. Vacío muestra enlace WhatsApp del agente.</div>
    </div>
    <div class="col-md-4">
        <label asp-for="WhatsAppNumber" class="form-label"></label>
        <input asp-for="WhatsAppNumber" class="form-control" placeholder="(945) 384-6408" />
        <div class="form-text">En la página y cuando Zelle está vacío. Usa el predeterminado si está en blanco.</div>
    </div>
    <div class="col-12">
        <hr class="my-1" />
        <h2 class="h6 text-muted mb-3">Contrato de arrendamiento (por propiedad)</h2>
        <p class="form-text">Placeholders: <code>{{MonthlyRent}}</code>, <code>{{SecurityDeposit}}</code>, <code>{{PropertyTitle}}</code>, <code>{{Address}}</code>, <code>{{VisitDeposit}}</code>. Los montos se calculan del alquiler mensual.</p>
    </div>
    <div class="col-md-6">
        <label asp-for="ContractTitle" class="form-label"></label>
        <input asp-for="ContractTitle" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="ContractSubtitle" class="form-label"></label>
        <input asp-for="ContractSubtitle" class="form-control" />
    </div>
    <div class="col-12">
        <label asp-for="ContractNoticeHtml" class="form-label"></label>
        <textarea asp-for="ContractNoticeHtml" class="form-control font-monospace" rows="3"></textarea>
    </div>
    <div class="col-12">
        <label asp-for="ContractBodyHtml" class="form-label"></label>
        <textarea asp-for="ContractBodyHtml" class="form-control font-monospace" rows="12"></textarea>
    </div>
    <div class="col-12">
        <hr class="my-1" />
        <h2 class="h6 text-muted mb-3">Acuerdo de estampillas y sellos (por propiedad)</h2>
        <p class="form-text">Placeholders: <code>{{StampsAmount}}</code>, <code>{{SealsAmount}}</code>, <code>{{TotalAmount}}</code>, <code>{{PropertyTitle}}</code>, <code>{{ZelleContact}}</code>.</p>
    </div>
    <div class="col-md-6">
        <label asp-for="StampSealTitle" class="form-label"></label>
        <input asp-for="StampSealTitle" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="StampSealSubtitle" class="form-label"></label>
        <input asp-for="StampSealSubtitle" class="form-control" />
    </div>
    <div class="col-12">
        <label asp-for="StampSealNoticeHtml" class="form-label"></label>
        <textarea asp-for="StampSealNoticeHtml" class="form-control font-monospace" rows="3"></textarea>
    </div>
    <div class="col-12">
        <label asp-for="StampSealBodyHtml" class="form-label"></label>
        <textarea asp-for="StampSealBodyHtml" class="form-control font-monospace" rows="10"></textarea>
    </div>
</div>
