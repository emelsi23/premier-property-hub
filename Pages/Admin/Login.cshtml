@page
@using ApartamentosRenta.Models
@model ApartamentosRenta.Pages.Admin.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Acceso administrador";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin · Premier Property Hub</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-login-page">
    <div class="admin-login-card">
        <div class="text-center mb-4">
            <partial name="_BrandLockup" model="@BrandLockupOptions.For("admin")" />
            <p class="text-muted small mb-0 mt-3">Acceso administrador</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label">Usuario</label>
                <input asp-for="Input.Username" class="form-control" autocomplete="username" autofocus />
            </div>
            <div class="mb-4">
                <label asp-for="Input.Password" class="form-label">Contraseña</label>
                <input asp-for="Input.Password" class="form-control" type="password" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Iniciar sesión</button>
        </form>
    </div>
</body>
</html>
