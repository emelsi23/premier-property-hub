@model ApartamentosRenta.Pages.Admin.Furniture.FurnitureProductInput
@{
    var categoryOptions = ViewData["CategoryOptions"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var existingPhotos = Model.ParseFotoUrls().ToList();
}

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Sku" class="form-label"></label>
        <input asp-for="Sku" class="form-control" placeholder="IW-LR-1001" />
        <span asp-validation-for="Sku" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control" placeholder="auto desde el título" />
        <div class="form-text">Vacío = se genera solo. URL: /furniture/item/tu-slug</div>
        <span asp-validation-for="Slug" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" class="form-select" asp-items="categoryOptions">
            <option value="0">Selecciona categoría</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="ShortDescription" class="form-label"></label>
        <input asp-for="ShortDescription" class="form-control" />
        <span asp-validation-for="ShortDescription" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CompareAtPrice" class="form-label"></label>
        <input asp-for="CompareAtPrice" class="form-control" type="number" step="0.01" min="0" />
        <div class="form-text">Opcional: precio tachado (oferta).</div>
    </div>
    <div class="col-md-4 d-flex align-items-end gap-4 pb-2">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
        <div class="form-check">
            <input asp-for="IsFeatured" class="form-check-input" />
            <label asp-for="IsFeatured" class="form-check-label"></label>
        </div>
    </div>

    <div class="col-12">
        <hr class="my-1" />
        <label class="form-label">Fotos del producto</label>
        @if (existingPhotos.Count > 0)
        {
            <div class="d-flex flex-wrap gap-2 mb-2">
                @foreach (var photoUrl in existingPhotos)
                {
                    <img src="@photoUrl" alt="Foto" class="rounded border" width="96" height="72" style="object-fit:cover;" />
                }
            </div>
            <p class="form-text">Quita URLs del cuadro de abajo para eliminar fotos.</p>
        }
        <label class="form-label fw-normal small text-muted">Subir desde tu PC</label>
        <input type="file" name="FotoUploads" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" multiple />
        <div class="form-text">JPG, PNG, WEBP o GIF · máx. 8 MB cada una · puedes seleccionar varias.</div>
        <span class="text-danger small" data-valmsg-for="FotoUploads" data-valmsg-replace="true"></span>
        <label asp-for="FotosUrls" class="form-label mt-3"></label>
        <textarea asp-for="FotosUrls" class="form-control font-monospace" rows="4" placeholder="https://...&#10;/uploads/furniture/..."></textarea>
        <div class="form-text">Opcional: una URL por línea (además de las subidas).</div>
        <span asp-validation-for="FotosUrls" class="text-danger"></span>
    </div>
</div>
