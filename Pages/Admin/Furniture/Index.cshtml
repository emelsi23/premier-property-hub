@page
@model ApartamentosRenta.Pages.Admin.Furniture.IndexModel
@{
    ViewData["Title"] = "Muebles";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1">Ironwood · Muebles</h1>
        <p class="text-muted mb-0">Catálogo público en <a href="/furniture" target="_blank">/furniture</a></p>
    </div>
    <a class="btn btn-primary" asp-page="Create">Nuevo producto</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="search" name="q" value="@Model.Query" class="form-control" placeholder="Buscar título o SKU…" />
    </div>
    <div class="col-md-3">
        <select name="categoryId" class="form-select" asp-items="Model.CategoryOptions">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Filtrar</button>
    </div>
</form>

@if (Model.Products.Count == 0)
{
    <div class="alert alert-light border">No hay productos. Crea el primero o espera el seed inicial.</div>
}
else
{
    <div class="table-responsive card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:72px"></th>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Products)
            {
                var thumb = p.Photos.OrderBy(x => x.SortOrder).Select(x => x.Url).FirstOrDefault()
                    ?? "/images/ironwood-logo.jpg";
                <tr>
                    <td>
                        <img src="@thumb" alt="" width="64" height="48" class="rounded border" style="object-fit:cover;" />
                    </td>
                    <td>
                        <div class="fw-semibold">@p.Title</div>
                        <div class="small text-muted">@p.Sku · /furniture/item/@p.Slug</div>
                    </td>
                    <td>@(p.Category?.Name ?? "—")</td>
                    <td>
                        $@p.Price.ToString("N2")
                        @if (p.CompareAtPrice is > 0)
                        {
                            <div class="small text-muted text-decoration-line-through">$@p.CompareAtPrice.Value.ToString("N2")</div>
                        }
                    </td>
                    <td>
                        @if (p.IsActive)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                        @if (p.IsFeatured)
                        {
                            <span class="badge bg-warning text-dark">Destacado</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@p.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@p.Id">Eliminar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
