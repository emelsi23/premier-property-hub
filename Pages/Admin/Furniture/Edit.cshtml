@page
@model ApartamentosRenta.Pages.Admin.Furniture.EditModel
@{
    ViewData["Title"] = "Editar mueble";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Editar producto</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" href="/furniture/item/@Model.CurrentSlug" target="_blank">Ver público</a>
        <a class="btn btn-outline-secondary btn-sm" asp-page="Index">Volver</a>
    </div>
</div>

<form method="post" enctype="multipart/form-data" class="card shadow-sm border-0">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_ProductForm" model="Model.Input" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
