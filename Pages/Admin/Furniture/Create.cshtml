@page
@model ApartamentosRenta.Pages.Admin.Furniture.CreateModel
@{
    ViewData["Title"] = "Nuevo mueble";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Nuevo producto</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-page="Index">Volver</a>
</div>

<form method="post" enctype="multipart/form-data" class="card shadow-sm border-0">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_ProductForm" model="Model.Input" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Guardar producto</button>
            <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
