@page
@model ApartamentosRenta.Pages.Admin.Furniture.DeleteModel
@{
    ViewData["Title"] = "Eliminar mueble";
}

<div class="card shadow-sm border-0">
    <div class="card-body">
        <h1 class="h3 mb-3">Eliminar producto</h1>
        <p>¿Seguro que deseas eliminar <strong>@Model.Title</strong>? Esta acción no se puede deshacer.</p>
        <form method="post" class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
        </form>
    </div>
</div>
