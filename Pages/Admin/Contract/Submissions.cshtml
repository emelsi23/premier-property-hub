@page
@model ApartamentosRenta.Pages.Admin.Contract.SubmissionsModel
@{
    ViewData["Title"] = "Firmas de contrato";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Firmas de contrato</h1>
        <p class="text-muted mb-0">Firmas y solicitudes de cambios por propiedad. Edita el texto del contrato en Editar propiedad.</p>
    </div>
    <a asp-page="/Admin/Index" class="btn btn-outline-secondary">← Propiedades</a>
</div>

@if (!Model.Submissions.Any())
{
    <div class="alert alert-info">Aún no hay envíos.</div>
}
else
{
    <div class="table-responsive card shadow-sm border-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Propiedad</th>
                    <th>Cliente</th>
                    <th>Tipo</th>
                    <th>Firma</th>
                    <th>Cambios propuestos</th>
                    <th>Enviado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Submissions)
                {
                    <tr>
                        <td>
                            <strong>@item.Propiedad.Titulo</strong><br />
                            <a href="/property/@item.Propiedad.Slug/contract" target="_blank" class="small">Ver contrato</a>
                        </td>
                        <td>
                            <strong>@item.TenantName</strong><br />
                            <a href="mailto:@item.TenantEmail" class="small">@item.TenantEmail</a>
                            @if (!string.IsNullOrWhiteSpace(item.TenantPhone))
                            {
                                <br /><span class="small text-muted">@item.TenantPhone</span>
                            }
                        </td>
                        <td>
                            @if (item.SubmissionType == ApartamentosRenta.Models.ContractSubmissionType.Signature)
                            {
                                <span class="badge bg-success">Firma</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">Solicitud de cambios</span>
                            }
                        </td>
                        <td>
                            @if (item.SignatureImageData is { Length: > 0 })
                            {
                                <a asp-page-handler="Signature" asp-route-id="@item.Id" target="_blank">
                                    <img src="@Url.Page(null, "Signature", new { id = item.Id })"
                                         alt="Firma"
                                         class="payment-proof-thumb" />
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="small" style="max-width: 280px; white-space: pre-wrap;">@(item.ProposedChanges ?? "—")</td>
                        <td class="small text-muted">@item.SubmittedAt.ToString("dd/MM/yyyy HH:mm") UTC</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
