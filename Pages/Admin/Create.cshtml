@page
@model ApartamentosRenta.Pages.Admin.CreateModel
@{
    ViewData["Title"] = "Nueva propiedad";
}

<h1 class="h3 mb-4">Nueva propiedad</h1>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form method="post" enctype="multipart/form-data" class="card shadow-sm border-0">
    <div class="card-body">
        <partial name="_PropertyForm" model="Model.Input" />
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="Index" class="btn btn-link">Cancelar</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
